<odoo>
    <record id="notification_config_form" model="ir.ui.view">
        <field name="name">dac.zalo.notification.config.form</field><field name="model">dac.zalo.config</field>
        <field name="inherit_id" ref="config_form"/>
        <field name="arch" type="xml"><xpath expr="//notebook" position="inside">
            <page name="notifications" string="Thông báo" groups="base.group_system">
                <div class="alert alert-info" role="note">
                    Nhân viên tùy chỉnh loại tin và giờ nhận trong “Thông báo của tôi”.
                    Chỉ sự kiện mới sau ngày bật tính năng mới được gửi.
                </div>
                <group>
                    <group string="Điều khiển chung">
                        <field name="notifications_enabled" widget="boolean_toggle"/>
                        <field name="notification_started_at" readonly="1"/>
                    </group>
                    <group string="Đơn hàng và công việc">
                        <field name="notify_order_created"/>
                        <field name="notify_order_updates"/>
                        <field name="notify_task_assigned"/>
                        <field name="notify_task_updates"/>
                        <field name="notify_deadline_changed"/>
                        <field name="notify_deadline_warning"/>
                        <field name="notify_task_overdue"/>
                        <field name="notify_personal_reminder"/>
                    </group>
                </group>
                <group>
                    <group string="Theo dõi đơn và nhân sự">
                        <field name="notify_handover"/>
                        <field name="notify_delivery"/>
                        <field name="notify_financial"/>
                        <field name="notify_mentions"/>
                        <field name="notify_hr_requests"/>
                        <field name="notify_hr_results"/>
                    </group>
                    <group string="Bản tin và cảnh báo">
                        <field name="notify_digest_morning"/>
                        <field name="notify_digest_evening"/>
                        <field name="notify_system_alerts"/>
                    </group>
                </group>
            </page>
        </xpath></field>
    </record>
    <record id="preference_form" model="ir.ui.view">
        <field name="name">dac.zalo.preference.form</field><field name="model">dac.zalo.preference</field>
        <field name="arch" type="xml"><form string="Thông báo của tôi" create="0" delete="0"><sheet>
            <group><group string="Cách nhận"><field name="user_id" readonly="1"/><field name="notifications_enabled" widget="boolean_toggle"/><field name="paused_until"/><field name="timezone"/></group>
                <group string="Giờ nhận"><field name="quiet_enabled"/><field name="quiet_start" widget="float_time"/><field name="quiet_end" widget="float_time"/><field name="urgent_outside_hours"/><field name="morning_hour" widget="float_time"/><field name="evening_hour" widget="float_time"/></group></group>
            <group><group string="Đơn hàng và công việc"><field name="order_created"/><field name="order_updates"/><field name="task_assigned"/><field name="task_updates"/><field name="deadline_changed"/><field name="deadline_warning"/><field name="task_overdue"/><field name="personal_reminder"/></group>
                <group string="Bàn giao và theo dõi"><field name="handover"/><field name="delivery"/><field name="financial"/><field name="mentions"/><field name="hr_requests"/><field name="hr_results"/><field name="digest_morning"/><field name="digest_evening"/><field name="system_alerts" groups="base.group_system"/></group></group>
            <div class="text-muted">Tắt thông báo không tắt hội thoại với trợ lý. Lệnh /congviec và /ai vẫn dùng được. Chỉ các thông tin bạn có quyền xem mới được gửi.</div>
        </sheet></form></field>
    </record>
    <record id="preference_action" model="ir.actions.server">
        <field name="name">Thông báo của tôi</field><field name="model_id" ref="model_dac_zalo_preference"/>
        <field name="state">code</field><field name="code">action = model.action_my_preferences()</field>
    </record>
    <record id="notification_list" model="ir.ui.view">
        <field name="name">dac.zalo.notification.list</field><field name="model">dac.zalo.notification</field>
        <field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="create_date"/><field name="user_id"/><field name="category"/><field name="state"/><field name="message_id"/><field name="expires_at" optional="hide"/><field name="error_message" optional="show"/></list></field>
    </record>
    <record id="notification_search" model="ir.ui.view">
        <field name="name">dac.zalo.notification.search</field><field name="model">dac.zalo.notification</field>
        <field name="arch" type="xml"><search><field name="user_id"/><field name="category"/><field name="state"/>
            <filter name="pending" string="Chờ xử lý / gửi" domain="[('state','in',['pending','queued'])]"/>
            <filter name="errors" string="Cần kiểm tra" domain="[('state','in',['failed','uncertain'])]"/>
        </search></field>
    </record>
    <record id="notification_action" model="ir.actions.act_window">
        <field name="name">Nhật ký thông báo</field><field name="res_model">dac.zalo.notification</field><field name="view_mode">list</field>
    </record>
    <menuitem id="menu_preferences" name="Thông báo của tôi" parent="menu_root" action="preference_action" sequence="3"/>
    <menuitem id="menu_notification_log" name="Nhật ký thông báo" parent="menu_root" action="notification_action" sequence="6"/>
</odoo>
