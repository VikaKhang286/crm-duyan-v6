<odoo noupdate="1">
    <record id="event_type_channel_test" model="dac.zalo.event.type">
        <field name="name">Tin thử</field>
        <field name="code">channel.test</field>
        <field name="group_name">Hệ thống</field>
        <field name="description">Tin thử khi bấm "Gửi tin thử" trên một hội thoại. Không cần đăng ký.</field>
        <field name="sequence">1000</field>
    </record>
    <record id="cron_zalo_channel_process" model="ir.cron">
        <field name="name">Zalo: gửi thông báo vào nhóm / hội thoại</field>
        <field name="model_id" ref="model_dac_zalo_channel_message"/>
        <field name="state">code</field>
        <field name="code">model._cron_process()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
