<odoo>
    <data>
        <record id="view_welcome_home_menu" model="ir.ui.view">
            <field name="name">Trang chủ</field>
            <field name="model">home.menu</field>
            <field name="arch" type="xml">
                <form string="Trang chủ" class="o_home_menu_form" create="0" edit="0" delete="0">
                    <sheet class="o_home_menu_sheet">
                        <div class="dac-home-dashboard">
                            <header class="dac-home-header">
                                <div><div class="dac-home-breadcrumb">Home</div><h1>Chào buổi sáng, <span data-home-user="">bạn</span> 👋</h1><p>Đây là những gì cần chú ý trong hệ thống Duy An hôm nay.</p></div>
                                <a role="button" class="dac-home-quick-task"><i class="fa fa-plus"/> Tạo task nhanh</a>
                            </header>
                            <div class="dac-home-stats">
                                <article><small>Việc của tôi</small><strong data-home-stat="my_tasks">0</strong><span><b data-home-stat="today_tasks">0</b> việc hôm nay</span></article>
                                <article class="is-danger"><small>Quá hạn</small><strong data-home-stat="overdue">0</strong><span>Cần xử lý ngay</span></article>
                                <article><small>Thông báo mới</small><strong data-home-stat="notifications">0</strong><span><b data-home-stat="approvals">0</b> yêu cầu duyệt</span></article>
                                <article><small>Đơn cần theo dõi</small><strong data-home-stat="orders">0</strong><span>Hôm nay</span></article>
                            </div>
                            <div class="dac-home-panels">
                                <section class="dac-home-panel"><header><h2>Lịch hôm nay</h2><p data-home-date=""/></header><div class="dac-home-schedule" data-home-schedule=""><div class="dac-home-empty">Đang tải lịch...</div></div></section>
                                <section class="dac-home-panel"><header><h2>Hoạt động gần đây</h2><p>Từ toàn hệ thống</p></header><div class="dac-home-activity" data-home-activity=""><div class="dac-home-empty">Đang tải hoạt động...</div></div></section>
                            </div>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="home_menu_record" model="home.menu">
            <field name="name">Trang chủ</field>
        </record>

        <record id="home_menu_action" model="ir.actions.act_window">
            <field name="name">Trang chủ</field>
            <field name="res_model">home.menu</field>
            <field name="view_mode">form</field>
            <field name="res_id" ref="home_menu_record"/>
        </record>
    </data>
</odoo>
