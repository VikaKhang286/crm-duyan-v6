<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dac_chat_playbook.ChatDemo">
        <div class="o_action dac_cd2">
            <header class="dac_cd2_head">
                <div>
                    <h1>Huấn luyện &amp; kiểm thử</h1>
                    <div class="dac_cd2_sub">Nhắn thử như khách; rê chuột vào câu bot trả lời để góp ý, rồi cho AI Agent tối ưu system prompt từ góp ý.
                        Không gửi gì cho khách thật.</div>
                </div>
            </header>
            <div t-if="!state.options" class="dac_cd2_loading"><i class="fa fa-circle-o-notch fa-spin me-2"/>Đang tải…</div>
            <div t-elif="!state.options.prompts.length" class="alert alert-info" role="alert">
                Chưa có bản system prompt nào. Chạy một đợt phân tích có AI để Agent viết 3 bộ prompt, rồi quay lại đây.
            </div>
            <div t-else="" class="dac_cd2_layout">
                <!-- Khung chat -->
                <section class="dac_cd2_chat_card">
                    <div class="dac_cd2_controls">
                        <label class="dac_cd2_field">
                            <span>Bộ prompt</span>
                            <select class="form-select form-select-sm" t-on-change="onPrompt" aria-label="Chọn bản system prompt">
                                <t t-foreach="state.options.prompts" t-as="p" t-key="p.id">
                                    <option t-att-value="p.id" t-att-selected="p.id === state.promptId" t-esc="p.label"/>
                                </t>
                            </select>
                        </label>
                        <label class="dac_cd2_field is-small">
                            <span>Tên khách</span>
                            <input type="text" class="form-control form-control-sm" t-model="state.customerName"/>
                        </label>
                        <label class="dac_cd2_field is-small">
                            <span>Kênh</span>
                            <select class="form-select form-select-sm" t-model="state.channel" aria-label="Kênh khách nhắn">
                                <t t-foreach="state.options.channels || []" t-as="c" t-key="c.key">
                                    <option t-att-value="c.key" t-esc="c.label"/>
                                </t>
                            </select>
                        </label>
                        <div class="dac_cd2_field is-wide">
                            <span>Giả lập lúc khách nhắn</span>
                            <div class="dac_cd2_presets">
                                <t t-foreach="state.options.presets" t-as="preset" t-key="preset.key">
                                    <button type="button" class="btn btn-sm" t-att-class="state.preset === preset.key ? 'btn-primary' : 'btn-outline-secondary'"
                                            t-on-click="() => this.pickPreset(preset)" t-esc="preset.label"/>
                                </t>
                                <input type="datetime-local" class="form-control form-control-sm dac_cd2_time" t-att-value="atLocal"
                                       t-on-change="onTime" aria-label="Chọn ngày giờ"/>
                            </div>
                        </div>
                    </div>

                    <div class="dac_cd2_chat" t-ref="chat" aria-live="polite">
                        <div t-if="!state.messages.length" class="dac_cd2_hint">
                            <i class="fa fa-comments-o"/>
                            <p>Gõ tin nhắn như khách hàng, hoặc bấm <b>Khách thật ngẫu nhiên</b> để lấy tin mở đầu của một khách mới gần đây.</p>
                        </div>
                        <t t-foreach="state.messages" t-as="m" t-key="m_index">
                            <div t-if="m.role === 'note'" class="dac_cd2_note" t-att-class="m.error ? 'is-error' : ''">
                                <i class="fa me-1" t-att-class="m.error ? 'fa-exclamation-triangle' : 'fa-user-circle'"/><t t-esc="m.text"/>
                            </div>
                            <div t-else="" class="dac_cd2_msg" t-att-class="(m.role === 'customer' ? 'is-customer' : 'is-bot') + (m.blocked ? ' is-blocked' : '')">
                                <div class="dac_cd2_bubble_row">
                                    <button t-if="m.role === 'bot' and m.turnEnd" type="button" class="dac_cd2_fb_btn" t-att-class="m.feedback ? 'has-feedback' : ''"
                                            t-on-click="() => this.openFeedback(m_index)" title="Góp ý cho cả lượt trả lời này" aria-label="Góp ý cho cả lượt trả lời này">
                                        <i class="fa" t-att-class="m.feedback ? 'fa-commenting' : 'fa-commenting-o'"/>
                                    </button>
                                    <div class="dac_cd2_bubble">
                                        <span t-if="m.blocked" class="dac_cd2_blocked_tag"><i class="fa fa-ban me-1"/>Bị chặn, không gửi</span>
                                        <t t-esc="m.text"/>
                                    </div>
                                </div>
                                <div t-if="m.feedback and state.fbFor !== m_index" class="dac_cd2_fb_saved"><i class="fa fa-check me-1"/>Góp ý cho lượt này: <t t-esc="m.feedback"/></div>
                                <div t-if="state.fbFor === m_index" class="dac_cd2_fb_form">
                                    <textarea class="form-control form-control-sm" rows="2" t-model="state.fbText" placeholder="Góp ý cho cả lượt trả lời này: vd nhắn ngắn hơn, tách 2 tin, đừng hỏi số điện thoại…"
                                              t-on-keydown="(ev) => this.onFeedbackKeydown(ev, m_index)" aria-label="Nội dung góp ý"/>
                                    <div class="dac_cd2_fb_actions">
                                        <button type="button" class="btn btn-sm btn-primary" t-on-click="() => this.saveFeedback(m_index)" t-att-disabled="!state.fbText.trim()">Lưu góp ý</button>
                                        <button type="button" class="btn btn-sm btn-link" t-on-click="cancelFeedback">Hủy</button>
                                    </div>
                                </div>
                                <div t-if="m.meta" class="dac_cd2_meta">
                                    <t t-esc="num(m.meta.in)"/> vào · <t t-esc="num(m.meta.out)"/> ra · <t t-esc="m.meta.seconds"/>s
                                </div>
                            </div>
                        </t>
                        <div t-if="state.sending" class="dac_cd2_msg is-bot"><div class="dac_cd2_bubble dac_cd2_typing"><span/><span/><span/></div></div>
                    </div>

                    <div t-if="state.optimizing" class="dac_cd2_improve is-busy" role="status">
                        <i class="fa fa-circle-o-notch fa-spin me-2"/>Đang cải tiến prompt (Haiku, thinking tối đa)… <t t-esc="state.optimizing.seconds"/>s
                    </div>
                    <div t-elif="state.improved" class="dac_cd2_improve is-done" role="status">
                        <div class="dac_cd2_improve_head">
                            <span><i class="fa fa-check-circle me-1"/>Đã có bản cải tiến: <b t-esc="state.improved.name"/>
                                <span class="text-muted small">(<t t-esc="state.improved.seconds"/>s<t t-if="state.improved.model"> · <t t-esc="state.improved.model"/></t>)</span></span>
                            <span class="d-flex gap-1">
                                <button type="button" class="btn btn-sm btn-primary" t-on-click="tryImproved" t-att-disabled="state.sending">
                                    <i class="fa fa-play me-1"/>Thử nghiệm bản cải tiến
                                </button>
                                <button type="button" class="btn btn-sm btn-link" t-on-click="() => this.state.improved = null">Để sau</button>
                            </span>
                        </div>
                        <pre t-if="state.improved.note" class="dac_cd2_improve_note" t-esc="state.improved.note"/>
                    </div>
                    <div t-elif="state.feedback.pending" class="dac_cd2_improve">
                        <span><i class="fa fa-commenting me-1"/><t t-esc="state.feedback.pending"/> góp ý chưa cải tiến vào bản này</span>
                        <button type="button" class="btn btn-sm btn-primary" t-on-click="optimize" t-att-disabled="state.sending">
                            <i class="fa fa-magic me-1"/>Cải tiến
                        </button>
                    </div>
                    <div class="dac_cd2_input">
                        <textarea class="form-control" rows="2" placeholder="Nhắn như khách… (Enter để gửi, Shift+Enter xuống dòng)"
                                  t-model="state.input" t-ref="input" t-on-keydown="onKeydown" t-att-disabled="state.sending" aria-label="Tin nhắn của khách"/>
                        <div class="dac_cd2_input_actions">
                            <button type="button" class="btn btn-primary" t-on-click="send" t-att-disabled="state.sending or !state.input.trim()">
                                <i class="fa fa-paper-plane me-1"/>Gửi
                            </button>
                            <button type="button" class="btn btn-outline-secondary" t-on-click="sample" t-att-disabled="state.sending">
                                <i class="fa fa-random me-1"/>Khách thật ngẫu nhiên
                            </button>
                            <button type="button" class="btn btn-link" t-on-click="reset" t-att-disabled="state.sending">Làm lại</button>
                        </div>
                    </div>
                </section>

                <!-- Bảng chi tiết -->
                <aside class="dac_cd2_panel">
                    <div class="dac_cd2_tabs" role="tablist">
                        <t t-foreach="[['feedback', 'Góp ý' + (state.feedback.pending ? ' (' + state.feedback.pending + ')' : '')], ['turn', 'Lượt này'], ['prompt', 'System prompt'], ['request', 'Request gửi đi'], ['session', 'Cả phiên']]" t-as="tab" t-key="tab[0]">
                            <button type="button" role="tab" class="dac_cd2_tab" t-att-class="state.tab === tab[0] ? 'is-active' : ''"
                                    t-att-aria-selected="state.tab === tab[0] ? 'true' : 'false'" t-on-click="() => this.setTab(tab[0])" t-esc="tab[1]"/>
                        </t>
                    </div>
                    <div class="dac_cd2_panel_body">
                        <t t-if="state.tab === 'feedback'">
                            <div class="dac_cd2_optimize">
                                <button type="button" class="btn btn-primary w-100" t-on-click="optimize"
                                        t-att-disabled="state.optimizing or !state.feedback.pending">
                                    <t t-if="state.optimizing"><i class="fa fa-circle-o-notch fa-spin me-1"/>Đang cải tiến… <t t-esc="state.optimizing.seconds"/>s</t>
                                    <t t-else=""><i class="fa fa-magic me-1"/>Cải tiến từ <t t-esc="state.feedback.pending"/> góp ý</t>
                                </button>
                                <div class="text-muted small mt-1">
                                    Haiku (thinking tối đa) viết lại system prompt của bản đang thử theo các góp ý đang bật, tạo một <b>bản nháp mới</b>
                                    (bản cũ giữ nguyên). Xong bấm <b>Thử nghiệm bản cải tiến</b> để gửi lại các tin khách vừa thử với bản mới.
                                </div>
                            </div>
                            <div t-if="state.feedback.note" class="dac_cd2_changes">
                                <h3>Agent đã sửa (so với <t t-esc="state.feedback.parent"/>)</h3>
                                <pre class="dac_cd2_pre" t-esc="state.feedback.note"/>
                            </div>
                            <h3>Góp ý của bộ này</h3>
                            <p t-if="!state.feedback.items.length" class="text-muted small">Chưa có góp ý. Rê chuột vào câu bot trả lời trong khung chat và bấm biểu tượng góp ý.</p>
                            <ul class="dac_cd2_fb_list">
                                <li t-foreach="state.feedback.items" t-as="f" t-key="f.id" t-att-class="f.active ? '' : 'is-off'">
                                    <div class="dac_cd2_fb_text" t-esc="f.text"/>
                                    <div t-if="f.bot" class="dac_cd2_fb_ctx">Khách: “<t t-esc="f.customer"/>” → Bot: “<t t-esc="f.bot"/>”</div>
                                    <div class="dac_cd2_fb_meta">
                                        <span t-esc="f.date"/> · <span t-esc="f.source"/><t t-if="f.author"> · <t t-esc="f.author"/></t>
                                        <span t-if="f.applied" class="badge text-bg-success ms-1">Đã có trong bản này</span>
                                        <span t-elif="!f.active" class="badge text-bg-light ms-1">Đang tắt</span>
                                        <span class="dac_cd2_fb_tools">
                                            <button type="button" class="btn btn-sm btn-link" t-on-click="() => this.toggleFeedback(f)" t-esc="f.active ? 'Tắt' : 'Bật'"/>
                                            <button type="button" class="btn btn-sm btn-link text-danger" t-on-click="() => this.deleteFeedback(f)">Xóa</button>
                                        </span>
                                    </div>
                                </li>
                            </ul>
                        </t>
                        <p t-elif="!state.last and state.tab !== 'session'" class="text-muted">Gửi một tin để xem chi tiết.</p>
                        <t t-elif="state.tab === 'turn'">
                            <t t-set="r" t-value="state.last"/>
                            <div class="dac_cd2_stats">
                                <div><span>Token vào</span><b t-esc="num(r.usage.in)"/></div>
                                <div><span>Token ra</span><b t-esc="num(r.usage.out)"/></div>
                                <div><span>Thời gian</span><b><t t-esc="r.seconds"/>s</b></div>
                                <div><span>Chi phí lượt</span><b><t t-esc="cost(r.usage.in or 0, r.usage.out or 0).vnd"/>đ</b></div>
                            </div>
                            <dl class="dac_cd2_dl">
                                <dt>Model</dt><dd t-esc="r.model or '–'"/>
                                <dt>Bối cảnh</dt><dd><t t-esc="r.context.now"/> · <t t-esc="r.context.work_status"/></dd>
                                <dt>Mốc hẹn</dt><dd t-esc="r.context.next"/>
                                <dt>Kênh</dt><dd t-esc="r.context.channel"/>
                                <dt>Chuyển nhân viên</dt>
                                <dd><span class="badge" t-att-class="r.handoff ? 'text-bg-warning' : 'text-bg-light'" t-esc="r.handoff ? 'Có' : 'Không'"/>
                                    <span t-if="r.handoff_reason" class="ms-1" t-esc="r.handoff_reason"/></dd>
                                <dt t-if="r.blocked.length">Tin bị chặn</dt><dd t-if="r.blocked.length" class="text-danger" t-esc="r.blocked.join(' / ')"/>
                            </dl>
                            <h3>Thông tin đã lấy được</h3>
                            <p t-if="!collectedRows.length" class="text-muted small">Chưa có.</p>
                            <table t-else="" class="table table-sm dac_cd2_table">
                                <tbody><t t-foreach="collectedRows" t-as="row" t-key="row[0]"><tr><th t-esc="row[0]"/><td t-esc="row[1]"/></tr></t></tbody>
                            </table>
                        </t>
                        <t t-elif="state.tab === 'prompt'">
                            <div class="dac_cd2_panel_tools">
                                <span class="text-muted small"><t t-esc="num(state.last.prompt_chars)"/> ký tự · đã điền bối cảnh, quy tắc cấm, khuôn trả lời</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="() => this.copy(state.last.system_prompt)"><i class="fa fa-copy me-1"/>Chép</button>
                            </div>
                            <pre class="dac_cd2_pre" t-esc="state.last.system_prompt"/>
                        </t>
                        <t t-elif="state.tab === 'request'">
                            <div class="dac_cd2_panel_tools">
                                <span class="text-muted small">Phần tin nhắn gửi kèm system prompt (SĐT đã che)</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="() => this.copy(state.last.user_text)"><i class="fa fa-copy me-1"/>Chép</button>
                            </div>
                            <pre class="dac_cd2_pre" t-esc="state.last.user_text"/>
                        </t>
                        <t t-elif="state.tab === 'session'">
                            <t t-set="c" t-value="cost(state.totals.in, state.totals.out)"/>
                            <div class="dac_cd2_stats">
                                <div><span>Số lượt</span><b t-esc="state.totals.turns"/></div>
                                <div><span>Token vào</span><b t-esc="num(state.totals.in)"/></div>
                                <div><span>Token ra</span><b t-esc="num(state.totals.out)"/></div>
                                <div><span>Thời gian TB</span><b><t t-esc="state.totals.turns ? (state.totals.seconds / state.totals.turns).toFixed(1) : 0"/>s</b></div>
                            </div>
                            <div class="dac_cd2_cost">
                                <div>Chi phí tham khảo cả phiên: <b><t t-esc="c.vnd"/>đ</b> (≈ $<t t-esc="c.usd"/>)</div>
                                <div class="text-muted small">Theo giá trong Thiết lập: $<t t-esc="state.options.pricing.in"/> / $<t t-esc="state.options.pricing.out"/>
                                    mỗi triệu token vào / ra, tỉ giá <t t-esc="num(state.options.pricing.rate)"/>đ. Nếu đi qua 9router gói thuê bao, số này là hạn mức gói chứ không phải tiền.</div>
                            </div>
                            <div t-if="prompt" class="text-muted small mt-2">Model trả lời của bản này: <t t-esc="prompt.model"/></div>
                        </t>
                    </div>
                </aside>
            </div>
        </div>
    </t>
</templates>
