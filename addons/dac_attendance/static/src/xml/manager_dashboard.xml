<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="dac_attendance.ManagerDashboard">
    <div class="o_dac_manager_dashboard">

        <!-- Loading -->
        <div t-if="state.loading" class="o_dac_dashboard_loading">
            <i class="fa fa-spinner fa-spin fa-2x text-muted"/>
            <p class="text-muted mt-2">Đang tải dữ liệu...</p>
        </div>

        <t t-else="">
            <div t-if="state.error" class="alert alert-danger m-4">
                <t t-esc="state.error"/>
            </div>

            <t t-else="">
                <!-- Header -->
                <div class="o_dac_mgr_header">
                    <div class="o_dac_mgr_heading">
                        <div class="o_dac_mgr_crumb">DAC Chấm công <span>/</span> Quản lý</div>
                        <h1>Dashboard Chấm công</h1>
                        <p>Tình trạng nhân sự hôm nay và các yêu cầu đang chờ duyệt.</p>
                    </div>
                    <div class="o_dac_mgr_header_actions">
                        <span class="o_dac_today_label" t-esc="todayLabel"/>
                        <button class="o_dac_btn_reports" t-on-click="openReports">
                            <i class="fa fa-bar-chart me-2"/>Báo cáo tháng
                        </button>
                        <button class="o_dac_btn_refresh" t-on-click="loadDashboard"
                                t-att-disabled="state.loading">
                            <i class="fa fa-refresh me-1"/>Làm mới
                        </button>
                    </div>
                </div>

                <!-- KPI Cards -->
                <div class="o_dac_kpi_row">
                    <div class="o_dac_kpi_card o_dac_kpi_card--present"
                         t-on-click="() => this.state.activeTab = 'present'">
                        <div class="o_dac_kpi_top"><div class="o_dac_kpi_label">Có mặt</div><span class="o_dac_kpi_icon"><i class="fa fa-users"/></span></div>
                        <div class="o_dac_kpi_number" t-esc="state.data.today_stats.present"/>
                        <div class="o_dac_kpi_meta"><strong><t t-esc="presentRate"/>%</strong> nhân sự</div>
                    </div>
                    <div class="o_dac_kpi_card o_dac_kpi_card--late"
                         t-on-click="() => this.state.activeTab = 'late'">
                        <div class="o_dac_kpi_top"><div class="o_dac_kpi_label">Đi muộn</div><span class="o_dac_kpi_icon"><i class="fa fa-clock-o"/></span></div>
                        <div class="o_dac_kpi_number" t-esc="state.data.today_stats.late"/>
                        <div class="o_dac_kpi_meta"><strong><t t-esc="lateRate"/>%</strong> hôm nay</div>
                    </div>
                    <div class="o_dac_kpi_card o_dac_kpi_card--absent"
                         t-on-click="() => this.state.activeTab = 'absent'">
                        <div class="o_dac_kpi_top"><div class="o_dac_kpi_label">Vắng</div><span class="o_dac_kpi_icon"><i class="fa fa-user-times"/></span></div>
                        <div class="o_dac_kpi_number" t-esc="state.data.today_stats.absent"/>
                        <div class="o_dac_kpi_meta"><t t-esc="state.data.today_stats.on_leave"/> có phép · <t t-esc="state.data.today_stats.unexplained_absent"/> chưa rõ</div>
                    </div>
                    <div class="o_dac_kpi_card o_dac_kpi_card--pending"
                         t-on-click="() => this.state.approvalTab = 'leaves'">
                        <div class="o_dac_kpi_top"><div class="o_dac_kpi_label">Chờ duyệt</div><span class="o_dac_kpi_icon"><i class="fa fa-list-alt"/></span></div>
                        <div class="o_dac_kpi_number" t-esc="state.data.today_stats.pending_approvals"/>
                        <div class="o_dac_kpi_meta"><t t-esc="state.data.today_stats.pending_leaves"/> nghỉ phép · <t t-esc="state.data.today_stats.pending_amendments"/> điều chỉnh</div>
                    </div>
                </div>

                <!-- Main content: 2 columns -->
                <div class="o_dac_mgr_main_row">

                    <!-- Weekly attendance rate (replaces the compact employee block) -->
                    <div class="o_dac_card o_dac_weekly_card">
                        <div class="o_dac_card_header">
                            <div><div class="o_dac_card_title">Tỷ lệ có mặt tuần này</div><div class="o_dac_card_subtitle">Theo ngày làm việc</div></div>
                        </div>
                        <div class="o_dac_weekly_grid">
                            <t t-foreach="state.data.weekly_attendance" t-as="day" t-key="day.label">
                                <div t-attf-class="o_dac_weekday {{ day.is_future ? 'o_dac_weekday--future' : '' }}">
                                    <span class="o_dac_weekday_label" t-esc="day.label"/>
                                    <div class="o_dac_weekday_bar">
                                        <span t-attf-class="{{ day.is_future ? 'o_dac_weekday_bar--future' : (day.rate > 90 ? 'o_dac_weekday_bar--green' : (day.rate >= 60 ? 'o_dac_weekday_bar--blue' : (day.rate >= 40 ? 'o_dac_weekday_bar--yellow' : 'o_dac_weekday_bar--red'))) }}" t-att-style="'width: ' + (day.rate || 0) + '%'"/>
                                    </div>
                                    <strong t-if="!day.is_future"><t t-esc="day.rate"/>%</strong>
                                    <strong t-else="">—</strong>
                                </div>
                            </t>
                        </div>
                    </div>

                    <!-- Approvals Panel -->
                    <div class="o_dac_card o_dac_approval_card">
                        <div class="o_dac_card_header">
                            <div><div class="o_dac_card_title">Yêu cầu chờ duyệt</div><div class="o_dac_card_subtitle">Xử lý trực tiếp tại dashboard</div></div>
                            <span t-if="state.data.today_stats.pending_approvals > 0" class="o_dac_pending_badge"><i class="fa fa-circle"/> <t t-esc="state.data.today_stats.pending_approvals"/> yêu cầu</span>
                        </div>

                        <div class="o_dac_approval_list o_dac_approval_list--compact">
                            <t t-if="!approvalItems.length"><p class="text-muted text-center py-4">Không có yêu cầu nào chờ duyệt.</p></t>
                            <t t-foreach="approvalItems" t-as="approval" t-key="approval.key">
                                <div class="o_dac_approval_item">
                                    <div class="o_dac_approval_initials" t-esc="approval.initials"/>
                                    <div class="o_dac_approval_content">
                                        <div class="o_dac_approval_name"><t t-esc="approval.employee_name"/> · <t t-esc="approval.title"/></div>
                                        <div class="o_dac_approval_detail" t-esc="approval.detail"/>
                                    </div>
                                    <button class="o_dac_btn_approve"
                                            t-on-click="() => approval.type === 'leave' ? this.onApproveLeave(approval.id) : this.onApproveAmendment(approval.id)"
                                            t-att-disabled="state.processingId === approval.id">Duyệt</button>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- Employee attendance is kept as a full-width operational list. -->
                <div class="o_dac_card o_dac_employee_table_card">
                    <div class="o_dac_card_header">
                        <div><div class="o_dac_card_title">Nhân viên hôm nay</div><div class="o_dac_card_subtitle">Hiện diện, thời gian vào/ra và xác thực</div></div>
                        <div class="o_dac_tab_row">
                            <button t-attf-class="o_dac_tab {{ state.activeTab === 'all' ? 'o_dac_tab--active' : '' }}" t-on-click="() => this.state.activeTab = 'all'">Tất cả</button>
                            <button t-attf-class="o_dac_tab {{ state.activeTab === 'present' ? 'o_dac_tab--active' : '' }}" t-on-click="() => this.state.activeTab = 'present'">Có mặt</button>
                            <button t-attf-class="o_dac_tab {{ state.activeTab === 'late' ? 'o_dac_tab--active' : '' }}" t-on-click="() => this.state.activeTab = 'late'">Đi muộn</button>
                            <button t-attf-class="o_dac_tab {{ state.activeTab === 'absent' ? 'o_dac_tab--active' : '' }}" t-on-click="() => this.state.activeTab = 'absent'">Vắng</button>
                        </div>
                    </div>

                    <div class="o_dac_employee_table">
                        <div class="o_dac_employee_table_head"><span>Nhân viên</span><span>Bộ phận</span><span>Check-in</span><span>Check-out</span><span>Giờ làm</span><span>Xác thực</span><span>Trạng thái</span></div>
                        <t t-if="!employeeList.length"><p class="text-muted text-center py-4">Chưa có dữ liệu nhân viên phù hợp.</p></t>
                        <t t-foreach="employeeList" t-as="emp" t-key="emp.employee_id">
                            <div class="o_dac_employee_table_row">
                                <span class="o_dac_employee_name"><i t-attf-class="fa {{ emp.is_absent ? 'fa-user-times text-danger' : (emp.is_late ? 'fa-clock-o text-warning' : 'fa-check-circle text-success') }}"/> <t t-esc="emp.name"/></span>
                                <span t-esc="emp.department"/>
                                <span><t t-esc="emp.check_in || '—'"/></span>
                                <span><t t-esc="emp.check_out || '—'"/></span>
                                <span t-esc="emp.worked_time"/>
                                <span class="o_dac_employee_verification" t-esc="emp.verification"/>
                                <span t-attf-class="o_dac_status_pill {{ emp.is_absent ? 'o_dac_status_pill--absent' : (emp.is_late ? 'o_dac_status_pill--late' : '') }}"><t t-esc="emp.is_absent ? 'Vắng' : (emp.is_late ? 'Đi muộn' : 'Có mặt')"/></span>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Refuse reason inline input (shown when refusing) -->
                <div t-if="state.refuseTarget" class="o_dac_refuse_overlay">
                    <div class="o_dac_refuse_box">
                        <h6>Nhập lý do từ chối</h6>
                        <textarea class="form-control mb-3" rows="3"
                                  t-att-value="state.refuseReason"
                                  placeholder="Lý do từ chối..."
                                  t-on-input="(e) => this.state.refuseReason = e.target.value"/>
                        <div class="d-flex gap-2 justify-content-end">
                            <button class="btn btn-sm btn-secondary"
                                    t-on-click="() => this.state.refuseTarget = null">
                                Hủy
                            </button>
                            <button class="btn btn-sm btn-danger" t-on-click="confirmRefuse">
                                Xác nhận từ chối
                            </button>
                        </div>
                    </div>
                </div>

            </t>
        </t>
    </div>
</t>

</templates>
