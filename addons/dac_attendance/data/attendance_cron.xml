<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Runs once after this version is installed/upgraded, then disables
             itself. It repairs records created before the midnight rule. -->
        <record id="cron_normalize_overnight_attendances" model="ir.cron">
            <field name="name">Chấm công: chuẩn hóa lịch sử qua ngày</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="state">code</field>
            <field name="code">model._cron_normalize_overnight_attendances()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="nextcall" eval="datetime.now().strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>

    <!-- Existing databases may have created this cron while it was noupdate.
         Unlock it first so an upgrade restores the active state and schedule. -->
    <function model="ir.model.data" name="write">
        <value model="ir.model.data" search="[('module', '=', 'dac_attendance'), ('name', '=', 'cron_auto_check_out_at_midnight')]"/>
        <value eval="{'noupdate': False}"/>
    </function>

    <!-- 17:00 UTC is midnight in Asia/Ho_Chi_Minh (UTC+7). -->
    <record id="cron_auto_check_out_at_midnight" model="ir.cron">
        <field name="name">Chấm công: tự check-out lúc 00:00</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_check_out_at_midnight()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(datetime.now().replace(hour=17, minute=0, second=0, microsecond=0) + timedelta(days=1 if datetime.now().hour >= 17 else 0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
