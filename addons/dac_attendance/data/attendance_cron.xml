<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Runs once after this version is installed/upgraded, then disables
             itself. It repairs records created before the midnight rule. -->
        <record id="cron_normalize_overnight_attendances" model="ir.cron">
            <field name="name">Chấm công: chuẩn hóa lịch sử qua ngày</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="state">code</field>
            <field name="code">model._cron_normalize_overnight_attendances()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="nextcall" eval="datetime.now().strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>

    <data noupdate="1">
        <!-- Runs once after upgrade to recalculate stored local dates and
             worked hours using the 17:30 cap, then disables itself. -->
        <record id="cron_recompute_attendance_cutoffs" model="ir.cron">
            <field name="name">Chấm công: tính lại dữ liệu theo mốc 17:30</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="state">code</field>
            <field name="code">model._cron_recompute_attendance_cutoffs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="nextcall" eval="datetime.now().strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>

    <!-- Existing databases may have created this cron while it was noupdate.
         Unlock it first so an upgrade restores the active state and schedule. -->
    <function model="ir.model.data" name="write">
        <value model="ir.model.data" search="[('module', '=', 'dac_attendance'), ('name', '=', 'cron_auto_check_out_at_midnight')]"/>
        <value eval="{'noupdate': False}"/>
    </function>

    <!-- Runs every minute so employee-local 18:00 is enforced without
         depending on the server timezone. -->
    <record id="cron_auto_check_out_at_midnight" model="ir.cron">
        <field name="name">Chấm công: tự check-out lúc 18:00</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_check_out_at_cutoff()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="nextcall" eval="datetime.now().strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
