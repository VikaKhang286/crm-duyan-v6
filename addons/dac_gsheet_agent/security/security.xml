<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Sale chỉ thấy phiên chat / tin nhắn / đề xuất của chính mình -->
        <record id="rule_gsheet_session_own" model="ir.rule">
            <field name="name">AI Sheet: phiên của tôi</field>
            <field name="model_id" ref="model_dac_gsheet_agent_session"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('dac_erp.group_dac_erp_sale'))]"/>
        </record>
        <record id="rule_gsheet_session_manager" model="ir.rule">
            <field name="name">AI Sheet: quản lý xem mọi phiên</field>
            <field name="model_id" ref="model_dac_gsheet_agent_session"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('dac_erp.group_dac_erp_manager')), (4, ref('base.group_system'))]"/>
        </record>

        <record id="rule_gsheet_message_own" model="ir.rule">
            <field name="name">AI Sheet: tin nhắn của tôi</field>
            <field name="model_id" ref="model_dac_gsheet_agent_message"/>
            <field name="domain_force">[('session_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('dac_erp.group_dac_erp_sale'))]"/>
        </record>
        <record id="rule_gsheet_message_manager" model="ir.rule">
            <field name="name">AI Sheet: quản lý xem mọi tin nhắn</field>
            <field name="model_id" ref="model_dac_gsheet_agent_message"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('dac_erp.group_dac_erp_manager')), (4, ref('base.group_system'))]"/>
        </record>

        <record id="rule_gsheet_proposal_own" model="ir.rule">
            <field name="name">AI Sheet: đề xuất của tôi</field>
            <field name="model_id" ref="model_dac_gsheet_agent_proposal"/>
            <field name="domain_force">[('session_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('dac_erp.group_dac_erp_sale'))]"/>
        </record>
        <record id="rule_gsheet_proposal_manager" model="ir.rule">
            <field name="name">AI Sheet: quản lý xem mọi đề xuất</field>
            <field name="model_id" ref="model_dac_gsheet_agent_proposal"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('dac_erp.group_dac_erp_manager')), (4, ref('base.group_system'))]"/>
        </record>
    </data>
</odoo>
