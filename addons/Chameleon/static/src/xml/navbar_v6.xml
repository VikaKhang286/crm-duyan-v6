<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="Chameleon.NavBarV6" t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//header" position="replace">
            <aside class="o_navbar dac_v6_shell" t-ref="root" aria-label="Điều hướng chính">
                <nav class="o_main_navbar d-print-none" data-command-category="disabled">
                    <div class="dac_v6_brand">
                        <span class="dac_v6_brandmark">
                            <img src="/Chameleon/static/src/img/duyan-logo.png" alt="Duy An Company"/>
                        </span>
                        <span class="dac_v6_brandcopy">
                            <strong>Duy An ERP</strong>
                            <small>ERP / CRM · v6</small>
                        </span>
                        <button class="dac_v6_collapse" type="button" title="Thu gọn sidebar"
                                aria-label="Thu gọn sidebar" t-on-click="toggleDacSidebar">
                            <i class="fa fa-bars"/>
                        </button>
                    </div>

                    <div class="dac_v6_tools" role="search">
                        <label class="dac_v6_search">
                            <i class="fa fa-search" aria-hidden="true"/>
                            <input type="search" placeholder="Tìm kiếm" aria-label="Tìm kiếm toàn cục"
                                   readonly="readonly" t-on-click="openDacGlobalSearch"/>
                            <span class="key-search">Ctrl K</span>
                        </label>
                        <button class="dac_v6_tool_button" type="button" title="Làm mới trang"
                                aria-label="Làm mới trang" t-on-click="refreshDacPage">
                            <i class="fa fa-refresh" aria-hidden="true"/>
                        </button>
                        <button aria-expanded="false"
                                class="dac_v6_tool_button"
                                type="button" title="Tin nhắn" t-on-click="openDacMessages">
                            <i class="fa fa-lg fa-comments" role="img" aria-label="Tin nhắn"/>
                        </button>
                        <button aria-expanded="false"
                                class="dac_v6_tool_button "
                                type="button" title="Hoạt động" t-on-click="openDacActivities">
                            <i class="fa fa-lg fa-clock-o" role="img" aria-label="Hoạt động"/>
                        </button>
                    </div>

                    <div class="o_navbar_breadcrumbs d-contents"/>

                    <div class="dac_v6_navigation_grid">
                        <div class="dac_v6_app_rail" aria-label="Ứng dụng">
                            <button t-foreach="menuService.getApps()" t-as="app" t-key="app.id"
                                    type="button"
                                    t-attf-class="dac_v6_app_button {{ currentApp &amp;&amp; currentApp.id === app.id ? 'is-active' : '' }}"
                                    t-att-title="app.name"
                                    t-on-click="() => this.onNavBarDropdownItemSelection(app)">
                                <span class="dac_v6_app_icon">
                                    <i t-attf-class="fa {{ dacAppIcon(app) }}" aria-hidden="true"/>
                                </span>
                                <span class="dac_v6_app_name" t-esc="app.name"/>
                            </button>
                        </div>

                        <div class="dac_v6_section_panel" aria-label="Chức năng">
                            <div class="dac_v6_section_heading" t-if="currentApp">
                                <strong t-esc="currentApp.name"/>
                            </div>
                            <div class="dac_v6_section_list">
                                <t t-foreach="currentAppSections" t-as="section" t-key="section.id">
                                    <t t-call="Chameleon.SidebarMenuItem">
                                        <t t-set="menu" t-value="section"/>
                                        <t t-set="level" t-value="0"/>
                                    </t>
                                </t>
                            </div>
                        </div>
                    </div>

                    <div class="o_menu_systray d-flex flex-shrink-0 ms-auto" role="menu">
                        <t t-foreach="systrayItems" t-as="item" t-key="item.key">
                            <div t-att-data-index="item.index"/>
                            <ErrorHandler onError="error => this.handleItemError(error, item)">
                                <t t-component="item.Component" t-props="item.props"/>
                            </ErrorHandler>
                        </t>
                    </div>
                </nav>
                <div t-if="dacSearchState.open" class="dac_v6_search_backdrop" t-on-click="closeDacSearchFromBackdrop">
                    <section class="dac_v6_search_dialog" role="dialog" aria-modal="true" aria-label="Tìm kiếm toàn cục">
                        <div class="dac_v6_search_dialog_input">
                            <i class="fa fa-search" aria-hidden="true"/>
                            <input t-ref="dacSearchInput" type="search"
                                   placeholder="Tìm đơn hàng, khách hàng, hội thoại, công việc..."
                                   t-att-value="dacSearchState.query" t-on-input="onDacSearchInput"
                                   t-on-keydown="onDacSearchKeydown"/>
                            <button type="button" t-on-click="closeDacGlobalSearch">ESC</button>
                        </div>
                        <div class="dac_v6_search_filters">
                            <button t-foreach="dacSearchCategories" t-as="category" t-key="category[0]" type="button"
                                    t-attf-class="{{ dacSearchState.category === category[0] ? 'is-active' : '' }}"
                                    t-on-click="() => this.selectDacSearchCategory(category[0])">
                                <t t-esc="category[1]"/>
                            </button>
                        </div>
                        <div class="dac_v6_search_results">
                            <div t-if="dacSearchState.loading" class="dac_v6_search_empty">
                                <i class="fa fa-spinner fa-spin"/> Đang tìm kiếm...
                            </div>
                            <button t-else="" t-foreach="dacSearchItems" t-as="item" t-key="item.key" type="button"
                                    t-attf-class="dac_v6_search_result {{ dacSearchState.activeIndex === item_index ? 'is-active' : '' }}"
                                    t-on-mouseenter="() => this.dacSearchState.activeIndex = item_index"
                                    t-on-click="() => this.openDacSearchItem(item)">
                                <span t-attf-class="dac_v6_search_result_icon is-{{ item.kind }}" t-esc="item.icon"/>
                                <span class="dac_v6_search_result_copy">
                                    <strong t-esc="item.title"/>
                                    <small t-if="item.subtitle" t-esc="item.subtitle"/>
                                </span>
                                <span class="dac_v6_search_result_type" t-esc="item.typeLabel"/>
                            </button>
                            <div t-if="!dacSearchState.loading and !dacSearchItems.length" class="dac_v6_search_empty">Không tìm thấy kết quả phù hợp</div>
                        </div>
                        <footer class="dac_v6_search_footer"><span>↑↓ Di chuyển</span><span>↵ Mở</span><span>Esc Đóng</span></footer>
                    </section>
                </div>
+                <div t-if="dacActivityState.open" class="dac_v6_activity_backdrop" t-on-click="closeDacActivitiesFromBackdrop">
                    <section class="dac_v6_activity_dialog" role="dialog" aria-modal="true" aria-label="Thông báo">
                        <header>
                            <h2>Thông báo</h2>
                            <button type="button" title="Đóng" aria-label="Đóng" t-on-click="closeDacActivities">
                                ✕
                            </button>
                        </header>
                        <div class="dac_v6_activity_list">
                            <div t-if="dacActivityState.loading" class="dac_v6_activity_empty">
                                <i class="fa fa-spinner fa-spin"/> Đang tải thông báo...
                            </div>
                            <button t-else="" t-foreach="dacActivityState.items" t-as="item" t-key="item.key"
                                    type="button" t-on-click="() => this.openDacActivityItem(item)">
                                <strong><t t-esc="item.count"/> <t t-esc="item.label"/></strong>
                            </button>
                            <div t-if="!dacActivityState.loading and !dacActivityState.items.length" class="dac_v6_activity_empty">
                                Không có thông báo cần xử lý
                            </div>
                        </div>
                        <footer>
                            <button type="button" t-on-click="closeDacActivities">Hủy</button>
                        </footer>
                    </section>
                </div>
            </aside>
        </xpath>
    </t>

    <t t-name="Chameleon.BurgerIdentity" t-inherit="web.BurgerMenu" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_mobile_menu_toggle')]" position="after">
            <div class="dac_v6_user_identity">
                <strong t-esc="user.name"/>
                <small t-if="dacIdentity.roleLabel" t-esc="dacIdentity.roleLabel"/>
            </div>
        </xpath>
    </t>

    <t t-name="Chameleon.SidebarMenuItem">
        <button t-if="!menu.childrenTree.length" type="button"
                t-attf-class="dac_v6_section_item level-{{ level }} {{ isDacSidebarMenuActive(menu) ? 'is-active' : '' }}"
                t-att-data-menu-xmlid="menu.xmlid"
                t-on-click="() => this.onDacSidebarMenuSelection(menu)">
            <span t-if="level &lt;= 1" t-attf-class="dac_v6_section_icon fa {{ dacSidebarMenuIcon(menu) }}" aria-hidden="true"/>
            <span t-else="" class="dac_v6_section_dot"/>
            <span t-esc="menu.name"/>
        </button>
        <div t-else="" t-attf-class="dac_v6_section_group level-{{ level }}">
            <button t-if="level === 1"
                    type="button"
                    t-attf-class="dac_v6_section_group_toggle {{ !isDacMenuGroupCollapsed(menu) ? 'is-active' : '' }}"
                    t-att-aria-expanded="!isDacMenuGroupCollapsed(menu)"
                    t-on-click="(event) => toggleDacMenuGroup(menu, event)">
                <span t-attf-class="fa {{ dacSidebarMenuIcon(menu) }}" aria-hidden="true"/>
                <span t-esc="menu.name"/>
                <span class="caret">›</span>
            </button>
            <div t-else="" class="dac_v6_section_group_title" t-esc="menu.name"/>
            <t t-if="!isDacMenuGroupCollapsed(menu)">
                <t t-foreach="menu.childrenTree" t-as="child" t-key="child.id">
                    <t t-call="Chameleon.SidebarMenuItem">
                        <t t-set="menu" t-value="child"/>
                        <t t-set="level" t-value="level + 1"/>
                    </t>
                </t>
            </t>
        </div>
    </t>
</templates>
