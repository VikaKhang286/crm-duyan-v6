<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="dac_report.ManagerDashboardV6">
    <div class="dac-manager-dashboard dac-viewport dac-operations-v6">
      <div t-if="state.loading" class="dac-dashboard-loading"><i class="fa fa-spinner fa-spin fa-3x"/><p>Đang tải dữ liệu...</p></div>
      <main t-else="" class="o_dac_manager_dashboard">
        <header class="dac-operations-header"><div><div class="dac-operations-breadcrumb">DAC Sản xuất &amp; Vận hành <span>/</span> Tổng quan</div><h1>Bảng Điều Phối Đơn</h1><p>Theo dõi pipeline thực thi, deadline và hiệu suất từng bộ phận.</p></div><div class="dac-operations-actions"><div class="dac-operations-periods"><button t-att-class="state.filterMode === 'week' ? 'active' : ''" t-on-click="() => this.setDashboardPeriod('week')">Tuần</button><button t-att-class="state.filterMode === 'month' ? 'active' : ''" t-on-click="() => this.setDashboardPeriod('month')">Tháng</button><button t-att-class="state.filterMode === 'custom' ? 'active' : ''" t-on-click="() => this.setDashboardPeriod('quarter')">Quý</button></div><button class="dac-operations-export" t-on-click="exportReport"><i class="fa fa-download"/> Xuất báo cáo</button></div></header>
        <section class="dac-operations-kpis"><article class="dac-operations-kpi is-alert"><span class="dac-operation-icon"><i class="fa fa-exclamation"/></span><small>Cảnh báo vận hành</small><strong><t t-esc="state.data.alerts.length"/></strong><p><b><t t-esc="state.data.delayed_production || 0"/> quá hạn</b> cần xử lý</p></article><article class="dac-operations-kpi is-debt"><span class="dac-operation-icon"><i class="fa fa-credit-card"/></span><small>Tổng công nợ</small><strong><t t-esc="formatCurrency(state.data.total_debt)"/></strong><p><t t-esc="state.data.payment_count || 0"/> đơn còn nợ</p></article><article class="dac-operations-kpi is-active"><span class="dac-operation-icon"><i class="fa fa-cube"/></span><small>Đơn đang hoạt động</small><strong><t t-esc="state.data.active_orders"/></strong><p><b>↑ <t t-esc="state.data.production_count || 0"/></b> đang sản xuất</p></article><article class="dac-operations-kpi is-revenue"><span class="dac-operation-icon"><i class="fa fa-bar-chart"/></span><small>Doanh thu kỳ này</small><strong><t t-esc="formatCurrency(state.data.total_revenue)"/></strong><p><b>↑</b> đơn hoàn thành trong kỳ</p></article></section>
        <section class="dac-operations-pipeline-panel"><header class="dac-operations-panel-head"><div><h2>Pipeline vận hành</h2><p>Báo giá → Thiết kế/Cọc → Sản xuất → Giao hàng → Hoàn thành</p></div><button t-on-click="openOrders">Chi tiết từng giai đoạn</button></header><div class="dac-operations-pipeline"><button class="dac-operation-stage" t-on-click="() => this.openOrdersByState('quotation')"><span>Báo giá</span><strong><t t-esc="state.data.quotation_count"/></strong><small><t t-esc="formatCurrency(state.data.quotation_amount)"/></small></button><button class="dac-operation-stage" t-on-click="() => this.openOrdersByState('deposit')"><span>Thiết kế/Cọc</span><strong><t t-esc="state.data.deposit_count"/></strong><small><t t-esc="formatCurrency(state.data.deposit_amount)"/></small></button><button class="dac-operation-stage" t-on-click="() => this.openOrdersByState('production')"><span>Sản xuất</span><strong><t t-esc="state.data.production_count"/></strong><small><t t-esc="formatCurrency(state.data.production_amount)"/></small></button><button class="dac-operation-stage" t-on-click="() => this.openOrdersByState('delivery')"><span>Giao hàng</span><strong><t t-esc="state.data.delivery_count"/></strong><small><t t-esc="formatCurrency(state.data.delivery_amount)"/></small></button><button class="dac-operation-stage" t-on-click="() => this.openOrdersByState('completed')"><span>Hoàn thành</span><strong><t t-esc="state.data.completed_count"/></strong><small><t t-esc="formatCurrency(state.data.completed_amount)"/></small></button></div></section>
        <section class="dac-operations-bottom"><article class="dac-operations-performance"><header class="dac-operations-panel-head"><div><h2>Hiệu suất bộ phận</h2><p>Tỷ lệ hoàn thành đúng hạn</p></div></header><div class="dac-operations-performance-list"><div><span>Kinh doanh</span><i><b class="yellow" t-att-style="'width:' + averageProgress(state.data.sales_performance) + '%'"/></i><strong><t t-esc="averageProgress(state.data.sales_performance)"/>%</strong></div><div><span>Thiết kế</span><i><b class="blue" t-att-style="'width:' + averageProgress(state.data.design_performance) + '%'"/></i><strong><t t-esc="averageProgress(state.data.design_performance)"/>%</strong></div><div><span>Sản xuất</span><i><b class="green" t-att-style="'width:' + averageProgress(state.data.production_performance) + '%'"/></i><strong><t t-esc="averageProgress(state.data.production_performance)"/>%</strong></div><div><span>Thi công</span><i><b class="orange" t-att-style="'width:' + installationProgress + '%'"/></i><strong><t t-esc="installationProgress"/>%</strong></div></div></article><article class="dac-operations-alerts"><header class="dac-operations-panel-head"><div><h2>Việc cần can thiệp hôm nay</h2><p>Xếp theo mức độ ảnh hưởng</p></div></header><div class="dac-operations-alert-list"><t t-if="state.data.alerts.length"><t t-foreach="state.data.alerts.slice(0, 4)" t-as="alert" t-key="alert.id"><button t-attf-class="dac-operation-alert #{alert.priority}" t-on-click="() => this.openOrder(alert.order_id)"><b><t t-esc="alert.priority === 'danger' ? '!' : '•'"/></b><span><strong><t t-esc="alert.label"/></strong><small><t t-if="alert.order_number"><t t-esc="alert.order_number"/> · </t><t t-esc="alert.customer_name"/></small></span><i class="fa fa-angle-right"/></button></t></t><div t-else="" class="dac-operations-empty"><i class="fa fa-check-circle"/> Chưa có việc cần can thiệp</div></div></article></section>
      </main>
    </div>
  </t>
</templates>
