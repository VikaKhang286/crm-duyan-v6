<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="dac_erp.DesignDashboard" owl="1">
    <div class="dac-viewport"><main class="o_dac_manager_dashboard dac-theme-design dac-design-v6">
      <header class="design-v6-header"><div><div class="design-v6-breadcrumb">DAC Sản xuất &amp; Vận hành / Thiết kế</div><h1>Dashboard Thiết kế</h1><p>Góc nhìn vai trò Thiết kế: deadline, ưu tiên, file và task cần hoàn thành.</p></div><div class="design-v6-actions"><button class="btn design-v6-btn design-v6-btn-light" t-on-click="openDesignCalendar"><i class="fa fa-calendar-o"/> Lịch thiết kế</button><button class="btn design-v6-btn design-v6-btn-primary" t-on-click="openCreateDesignTask"><i class="fa fa-plus"/> Task thiết kế</button></div></header>
      <t t-if="state.loading"><div class="design-v6-loading"><i class="fa fa-spinner fa-pulse"/> Đang tải dữ liệu thiết kế…</div></t>
      <t t-elif="state.error"><div class="alert alert-danger"><t t-esc="state.error"/></div></t>
      <t t-else="">
        <section class="design-v6-kpis">
          <article class="design-v6-kpi"><span>Tổng việc</span><strong><t t-esc="taskStats.total || 0"/></strong><small><t t-esc="taskStats.in_progress || 0"/> đang xử lý</small></article>
          <article class="design-v6-kpi design-v6-kpi-danger"><span>Quá hạn</span><strong><t t-esc="taskStats.overdue || 0"/></strong><small>Cần ưu tiên</small></article>
          <article class="design-v6-kpi"><span>Sắp đến hạn</span><strong><t t-esc="taskStats.due_soon || 0"/></strong><small>Trong 48 giờ</small></article>
          <article class="design-v6-kpi"><span>Hoàn thành tháng</span><strong><t t-esc="taskStats.done_month || 0"/></strong><small class="design-v6-positive"><t t-esc="taskStats.on_time_rate || 0"/>% đúng hạn</small></article>
        </section>
        <section class="design-v6-board">
          <article class="design-v6-panel design-v6-priority"><div class="design-v6-panel-head"><div><h2>Việc thiết kế ưu tiên</h2><p>Bấm đơn để mở trang chi tiết.</p></div></div><div class="design-v6-task-list">
            <t t-if="designTasks.length"><t t-foreach="designTasks.slice(0, 8)" t-as="task" t-key="task.id"><button class="design-v6-task" t-on-click="() => this.openTaskOrOrder(task)"><span t-attf-class="design-v6-task-mark #{task.is_overdue ? 'is-overdue' : ''}"><t t-if="task.is_overdue">!</t><t t-elif="task.priority === 'urgent'">!</t><t t-else=""><t t-esc="task.days_left !== false ? task.days_left : '•'"/></t></span><span class="design-v6-task-copy"><strong><t t-esc="task.order_number || task.order_name || task.name"/><t t-if="task.order_title"> · <t t-esc="task.order_title"/></t></strong><small t-if="task.is_overdue">Quá hạn<t t-if="task.description"> · <t t-esc="task.description"/></t></small><small t-else="">Deadline <t t-esc="task.deadline_str || 'chưa đặt'"/><t t-if="task.description"> · <t t-esc="task.description"/></t></small></span><i class="fa fa-angle-right"/></button></t></t>
            <div t-else="" class="design-v6-empty"><span><i class="fa fa-paint-brush"/></span><strong>Chưa có việc thiết kế</strong><p>Task mới được giao sẽ xuất hiện tại đây.</p></div>
          </div></article>
          <article class="design-v6-panel design-v6-distribution"><div class="design-v6-panel-head"><div><h2>Phân bổ trạng thái</h2><p><t t-esc="designDistribution.total || 0"/> task thiết kế trong tháng</p></div></div><div class="design-v6-chart-wrap"><div class="design-v6-donut" t-att-style="'background:' + distributionStyle"><div><strong><t t-esc="designDistribution.total || 0"/></strong><span>task</span></div></div><div class="design-v6-legend"><div><i class="is-designing"/><span>Đang thiết kế</span><strong><t t-esc="designDistribution.designing || 0"/></strong></div><div><i class="is-waiting"/><span>Chờ duyệt</span><strong><t t-esc="designDistribution.waiting || 0"/></strong></div><div><i class="is-revision"/><span>Cần sửa</span><strong><t t-esc="designDistribution.revision || 0"/></strong></div><div><i class="is-ready"/><span>Sẵn sàng SX</span><strong><t t-esc="designDistribution.ready || 0"/></strong></div></div></div></article>
        </section>
      </t>
    </main></div>
  </t>
</templates>
