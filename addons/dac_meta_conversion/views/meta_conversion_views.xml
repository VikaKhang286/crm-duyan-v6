<odoo>
    <record id="meta_conversion_event_list" model="ir.ui.view">
        <field name="name">dac.meta.conversion.event.list</field>
        <field name="model">dac.meta.conversion.event</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-success="state == 'sent'" decoration-warning="state in ('waiting', 'retry', 'uncertain')" decoration-danger="state == 'error'">
                <field name="order_id"/>
                <field name="delivery_provider"/>
                <field name="event_time"/>
                <field name="state" widget="badge"/>
                <field name="channel"/>
                <field name="attempt_count"/>
                <field name="message"/>
                <field name="sent_at" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="meta_conversion_event_form" model="ir.ui.view">
        <field name="name">dac.meta.conversion.event.form</field>
        <field name="model">dac.meta.conversion.event</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group><field name="order_id"/><field name="state"/><field name="message"/><field name="event_id"/><field name="event_time"/><field name="company_id"/></group>
                        <group><field name="delivery_provider"/><field name="pancake_shop_id" invisible="delivery_provider != 'pancake_pos'"/><field name="pancake_remote_id" invisible="delivery_provider != 'pancake_pos'"/><field name="dataset_id" invisible="delivery_provider == 'pancake_pos'"/><field name="page_id"/><field name="channel"/><field name="test_code" invisible="delivery_provider == 'pancake_pos'"/><field name="attempt_count"/><field name="last_attempt_at"/><field name="next_attempt_at"/><field name="sent_at"/><field name="trace_id"/></group>
                    </group>
                    <notebook>
                        <page string="Lịch sử từng lần gọi API" name="api_logs">
                            <field name="api_log_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="started_at"/><field name="attempt_number"/>
                                    <field name="state" widget="badge"/><field name="http_status"/>
                                    <field name="events_received"/><field name="summary"/><field name="trace_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_meta_conversion_events" model="ir.actions.act_window">
        <field name="name">Chuyển đổi Meta</field>
        <field name="res_model">dac.meta.conversion.event</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
