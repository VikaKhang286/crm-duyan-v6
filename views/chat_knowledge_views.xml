<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="chat_knowledge_view_list" model="ir.ui.view">
        <field name="name">dac.chat.knowledge.list</field>
        <field name="model">dac.chat.knowledge</field>
        <field name="arch" type="xml">
            <list string="Kiến thức doanh nghiệp">
                <field name="category"/>
                <field name="name"/>
                <field name="content"/>
                <field name="scope" widget="badge" decoration-info="scope == 'all'" decoration-success="scope == 'info'" decoration-warning="scope == 'consult'"/>
                <field name="char_count" optional="hide"/>
                <field name="source_url" widget="url" optional="show"/>
            </list>
        </field>
    </record>

    <record id="chat_knowledge_view_form" model="ir.ui.view">
        <field name="name">dac.chat.knowledge.form</field>
        <field name="model">dac.chat.knowledge</field>
        <field name="arch" type="xml">
            <form string="Kiến thức doanh nghiệp">
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="VD: Hộp đèn, LED"/></h1></div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="scope"/>
                        </group>
                        <group>
                            <field name="source_url" widget="url"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="char_count"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="note">Viết ngắn gọn, đúng sự thật. Không ghi giá. Thời gian/bảo hành chỉ là thông tin chung,
                        chatbot sẽ nói bạn phụ trách xác nhận cụ thể.</div>
                    <field name="content" nolabel="1" placeholder="Nội dung chatbot được phép dùng khi trả lời khách"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="chat_knowledge_view_search" model="ir.ui.view">
        <field name="name">dac.chat.knowledge.search</field>
        <field name="model">dac.chat.knowledge</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="content"/>
                <filter name="archived" string="Đã ẩn" domain="[('active', '=', False)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_category" string="Nhóm" context="{'group_by': 'category'}"/>
                    <filter name="group_scope" string="Dùng cho" context="{'group_by': 'scope'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="chat_knowledge_action" model="ir.actions.act_window">
        <field name="name">Kiến thức doanh nghiệp</field>
        <field name="res_model">dac.chat.knowledge</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_category': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có kiến thức nào</p>
            <p>Thêm thông tin công ty, sản phẩm, quy trình, chính sách để chatbot trả lời nhanh câu hỏi của khách.</p>
        </field>
    </record>
</odoo>
