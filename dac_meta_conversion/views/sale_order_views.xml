<odoo>
    <record id="sale_order_form_meta_conversion" model="ir.ui.view">
        <field name="name">sale.order.form.meta.conversion</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="dac_erp.dac_sale_order_custom_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Chuyển đổi Meta" name="meta_conversion" groups="dac_erp.group_dac_erp_sale,dac_erp.group_dac_erp_manager,base.group_system">
                    <group>
                        <field name="meta_conversion_state"/>
                        <field name="meta_conversion_message"/>
                        <field name="meta_conversion_psid" readonly="meta_conversion_state in ('sent', 'test_sent', 'sending', 'uncertain')"/>
                    </group>
                    <button name="action_meta_retry" type="object" string="Kiểm tra dữ liệu và gửi lại" class="btn-secondary" invisible="meta_conversion_state not in ('waiting', 'error', 'retry', 'pending')"/>
                    <button name="action_meta_open_api_logs" type="object" string="Xem lịch sử API của đơn" class="btn-link" groups="base.group_system,dac_erp.group_dac_erp_manager"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
