<odoo>
    <record id="meta_event_company_rule" model="ir.rule">
        <field name="name">Chuyển đổi Meta: công ty được phép</field>
        <field name="model_id" ref="model_dac_meta_conversion_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="meta_api_log_company_rule" model="ir.rule">
        <field name="name">Lịch sử API Meta: công ty được phép</field>
        <field name="model_id" ref="model_dac_meta_api_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
