<odoo>
    <record id="config_form" model="ir.ui.view">
        <field name="name">dac.push.config.form</field><field name="model">dac.push.config</field>
        <field name="arch" type="xml"><form string="Push DAC Odoo" create="0" delete="0"><sheet>
            <div class="alert alert-info" role="note">Cài plugin <strong>Push DAC Odoo</strong> trên duyan.vn, dán địa chỉ nhận và khóa bí mật bên dưới vào trang cài đặt của plugin.</div>
            <group>
                <field name="active" widget="boolean_toggle"/>
                <field name="endpoint_url" widget="CopyClipboardChar" readonly="1"/>
                <label for="secret"/>
                <div class="d-flex gap-2">
                    <field name="secret" password="True" widget="CopyClipboardChar" class="flex-grow-1"/>
                    <button name="action_generate_secret" type="object" string="Tạo khóa mới" class="btn-secondary"
                        confirm="Tạo khóa mới sẽ làm plugin hiện tại bị từ chối cho đến khi bạn cập nhật khóa trên WordPress. Tiếp tục?"/>
                </div>
            </group>
        </sheet></form></field>
    </record>
    <record id="config_action" model="ir.actions.act_window">
        <field name="name">Cấu hình Push DAC Odoo</field><field name="res_model">dac.push.config</field>
        <field name="view_mode">form</field><field name="res_id" ref="config_default"/>
    </record>

    <record id="event_list" model="ir.ui.view">
        <field name="name">dac.push.event.list</field><field name="model">dac.push.event</field>
        <field name="arch" type="xml"><list create="0" decoration-danger="state == 'failed'" decoration-muted="state == 'ignored'">
            <field name="create_date"/><field name="source"/><field name="event_type"/><field name="event_id" optional="hide"/>
            <field name="state" widget="badge"/><field name="error_message"/>
        </list></field>
    </record>
    <record id="event_form" model="ir.ui.view">
        <field name="name">dac.push.event.form</field><field name="model">dac.push.event</field>
        <field name="arch" type="xml"><form create="0"><header>
            <button name="action_reprocess" type="object" string="Xử lý lại" class="btn-primary" invisible="state not in ('failed','ignored')"/>
            <field name="state" widget="statusbar"/></header><sheet>
            <group><field name="source"/><field name="event_type"/><field name="event_id"/><field name="handled_at"/><field name="error_message"/></group>
            <field name="payload" groups="base.group_system" widget="text"/>
        </sheet></form></field>
    </record>
    <record id="event_action" model="ir.actions.act_window">
        <field name="name">Dữ liệu nhận được</field><field name="res_model">dac.push.event</field><field name="view_mode">list,form</field>
    </record>

    <record id="web_lead_list" model="ir.ui.view">
        <field name="name">dac.web.lead.list</field><field name="model">dac.web.lead</field>
        <field name="arch" type="xml"><list create="0">
            <field name="received_at"/><field name="site"/><field name="form_type"/><field name="customer_name"/>
            <field name="phone"/><field name="items"/><field name="page_url" optional="hide"/>
        </list></field>
    </record>
    <record id="web_lead_form" model="ir.ui.view">
        <field name="name">dac.web.lead.form</field><field name="model">dac.web.lead</field>
        <field name="arch" type="xml"><form create="0"><sheet>
            <group><group><field name="customer_name"/><field name="phone"/><field name="email"/><field name="company_name"/><field name="items"/></group>
                <group><field name="site"/><field name="form_type"/><field name="form_name"/><field name="page_url"/><field name="submitted_at"/><field name="received_at"/></group></group>
            <field name="message"/>
        </sheet></form></field>
    </record>
    <record id="web_lead_action" model="ir.actions.act_window">
        <field name="name">Lead từ website</field><field name="res_model">dac.web.lead</field><field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_push_root" name="Push DAC Odoo" sequence="96" groups="dac_erp.group_dac_erp_manager,base.group_system"/>
    <menuitem id="menu_web_lead" name="Lead từ website" parent="menu_push_root" action="web_lead_action" sequence="1"/>
    <menuitem id="menu_push_event" name="Dữ liệu nhận được" parent="menu_push_root" action="event_action" sequence="2"/>
    <menuitem id="menu_push_config" name="Cấu hình" parent="menu_push_root" action="config_action" groups="base.group_system" sequence="3"/>
</odoo>
