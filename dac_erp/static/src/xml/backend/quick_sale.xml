<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="dac_erp.QuickSaleDrawer" owl="1">
    <t t-if="state.open">
      <div class="dac-quick-sale-layer" t-on-click="onBackdrop">
        <aside class="dac-quick-sale" role="dialog" aria-modal="true" aria-label="Thông tin nhanh đơn hàng">
          <header class="dac-quick-sale-head">
            <div><span>ĐƠN HÀNG</span><h2><t t-esc="state.order?.number || 'Đang tải…'"/></h2><p t-if="state.order"><t t-esc="state.order.partner_name"/><t t-if="state.order.phone"> · <t t-esc="state.order.phone"/></t></p></div>
            <button type="button" aria-label="Đóng" t-on-click="quickSale.close"><i class="fa fa-times"/></button>
          </header>
          <div class="dac-quick-sale-body">
            <div t-if="state.loading" class="dac-quick-sale-loading"><i class="fa fa-spinner fa-pulse"/><span>Đang tải thông tin đơn hàng…</span></div>
            <div t-elif="state.error" class="alert alert-danger"><t t-esc="state.error"/></div>
            <t t-elif="state.order">
              <section class="dac-quick-sale-value">
                <div><span>Tổng giá trị</span><strong><t t-esc="formatMoney(state.order.amount_total)"/></strong></div>
                <b t-attf-class="is-#{state.order.state}"><i/> <t t-esc="state.order.state_label"/></b>
              </section>
              <section class="dac-quick-sale-stages">
                <div t-foreach="stages" t-as="stage" t-key="stage[0]" t-attf-class="dac-quick-stage #{stageStatus(stage[0])}">
                  <i><t t-esc="stageStatus(stage[0]) === 'done' ? '✓' : stage_index + 1"/></i><span><t t-esc="stage[1]"/></span>
                </div>
              </section>
              <section class="dac-quick-sale-section">
                <h3>Thông tin nhanh</h3>
                <div class="dac-quick-sale-info">
                  <div><span>Sale phụ trách</span><strong><t t-esc="state.order.sale_name || 'Chưa phân công'"/></strong></div>
                  <div><span>Deadline</span><strong t-att-class="state.order.is_overdue ? 'text-danger' : ''"><t t-esc="state.order.deadline || 'Chưa đặt'"/></strong></div>
                  <div><span>Đã thanh toán</span><strong><t t-esc="formatMoney(state.order.paid_amount)"/></strong></div>
                  <div><span>Còn công nợ</span><strong t-att-class="state.order.remaining_amount ? 'text-danger' : ''"><t t-esc="formatMoney(state.order.remaining_amount)"/></strong></div>
                </div>
              </section>
              <section class="dac-quick-sale-section">
                <h3>Công việc liên quan <small t-if="state.order.task_count"><t t-esc="state.order.task_count"/></small></h3>
                <div t-if="state.order.tasks.length" class="dac-quick-task-list">
                  <div t-foreach="state.order.tasks" t-as="task" t-key="task.id" class="dac-quick-task">
                    <i t-attf-class="#{task.state === 'done' ? 'done' : task.is_overdue ? 'overdue' : ''}"><t t-esc="task.state === 'done' ? '✓' : task_index + 1"/></i>
                    <div><strong><t t-esc="task.name"/></strong><span><t t-esc="task.state_label"/><t t-if="task.assignee"> · <t t-esc="task.assignee"/></t><t t-if="task.deadline"> · <t t-esc="task.deadline"/></t></span></div>
                  </div>
                </div>
                <div t-else="" class="dac-quick-sale-empty">Chưa có công việc liên quan.</div>
              </section>
            </t>
          </div>
          <footer t-if="state.order" class="dac-quick-sale-actions">
            <h3>Hành động nhanh</h3>
            <div><button class="primary" t-on-click="quickSale.recordPayment">Ghi nhận thanh toán</button><button t-on-click="quickSale.createTask">+ Tạo task</button><button t-on-click="quickSale.openConversation">Mở hội thoại</button><button class="primary compact" t-on-click="quickSale.openFull">Xem đầy đủ</button></div>
          </footer>
        </aside>
      </div>
    </t>
  </t>
</templates>
