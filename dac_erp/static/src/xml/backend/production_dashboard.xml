<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="dac_erp.ProductionDashboard" owl="1">
    <div class="dac-viewport">
      <main class="o_dac_dashboard dac-theme-production dac-production-v6">
        <header class="prod-v6-header">
          <div><div class="prod-v6-breadcrumb">DAC Sản xuất &amp; Vận hành / Sản xuất</div><h1>Dashboard Sản xuất</h1><p>Góc nhìn vai trò Sản xuất: đơn trong xưởng, tiến độ, deadline và việc bị chặn.</p></div>
          <div class="prod-v6-actions"><button class="btn prod-v6-btn prod-v6-btn-light" t-on-click="openProductionOrders"><i class="fa fa-calendar-o"/> Lịch sản xuất</button><button class="btn prod-v6-btn prod-v6-btn-primary" t-on-click="_load"><i class="fa fa-refresh"/> Cập nhật tiến độ</button></div>
        </header>
        <t t-if="state.loading"><div class="prod-v6-loading"><i class="fa fa-spinner fa-pulse"/> Đang tải dữ liệu sản xuất…</div></t>
        <t t-elif="state.error"><div class="alert alert-danger"><t t-esc="state.error"/></div></t>
        <t t-else="">
          <section class="prod-v6-kpis">
            <article class="prod-v6-kpi"><span>Đơn trong xưởng</span><strong><t t-esc="productionStats.active || 0"/></strong><small><t t-esc="formatMoney(productionStats.active_value)"/> giá trị</small></article>
            <article class="prod-v6-kpi prod-v6-kpi-danger"><span>Quá hạn</span><strong><t t-esc="productionStats.overdue || 0"/></strong><small>Cần can thiệp</small></article>
            <article class="prod-v6-kpi"><span>Sắp hoàn thành</span><strong><t t-esc="productionStats.finishing_soon || 0"/></strong><small>Trong 48 giờ</small></article>
            <article class="prod-v6-kpi"><span>Đúng hạn tháng</span><strong><t t-esc="productionStats.on_time_rate || 0"/>%</strong><small class="prod-v6-positive"><i class="fa fa-arrow-up"/> Theo tiến độ hiện tại</small></article>
          </section>
          <section class="prod-v6-board">
            <article class="prod-v6-panel prod-v6-orders">
              <div class="prod-v6-panel-head"><div><h2>Đơn đang sản xuất</h2><p>Xếp theo deadline gần nhất.</p></div><button class="prod-v6-link" t-on-click="openProductionOrders">Xem tất cả</button></div>
              <div class="prod-v6-order-list">
                <t t-if="productionOrders.length"><t t-foreach="productionOrders" t-as="order" t-key="order.id"><button class="prod-v6-order" t-on-click="() => this.openOrder(order)"><span t-attf-class="prod-v6-progress #{order.is_overdue ? 'is-overdue' : ''}"><t t-if="order.is_overdue">!</t><t t-else=""><t t-esc="order.progress"/></t></span><span class="prod-v6-order-copy"><strong><t t-esc="order.number"/> · <t t-esc="order.title"/></strong><small t-if="order.is_overdue">Quá hạn · còn <t t-esc="order.remaining_tasks"/> task</small><small t-else=""><t t-esc="order.progress"/>% · Deadline <t t-esc="order.deadline || 'Chưa đặt'"/> · <t t-esc="order.team"/></small></span><i class="fa fa-angle-right"/></button></t></t>
                <div t-else="" class="prod-v6-empty"><span><i class="fa fa-industry"/></span><strong>Chưa có đơn trong xưởng</strong><p>Đơn chuyển sang trạng thái Sản xuất sẽ xuất hiện tại đây.</p></div>
              </div>
            </article>
            <article class="prod-v6-panel prod-v6-workload">
              <div class="prod-v6-panel-head"><div><h2>Tải xưởng</h2><p>Tiến độ theo tổ sản xuất</p></div></div>
              <div class="prod-v6-load-list" t-if="workshopLoads.length"><div class="prod-v6-load" t-foreach="workshopLoads" t-as="load" t-key="load.name"><span><t t-esc="load.name"/></span><div><i t-att-style="'width:' + load.progress + '%'"/></div><strong><t t-esc="load.progress"/>%</strong></div></div>
              <div t-else="" class="prod-v6-empty prod-v6-empty-small"><span><i class="fa fa-bar-chart"/></span><strong>Chưa có dữ liệu tải xưởng</strong><p>Phân công nhân sự để theo dõi tiến độ theo tổ.</p></div>
            </article>
          </section>
        </t>
      </main>
    </div>
  </t>
</templates>
