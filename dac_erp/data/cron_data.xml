<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron job kiểm tra và đồng bộ dòng đặt cọc và trạng thái hoàn thành -->
        <record id="ir_cron_check_all_orders_payment" model="ir.cron">
            <field name="name">Kiểm tra trạng thái hoàn thành các đơn hàng</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_deposit_payments()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!-- Cron job để update missing dac_user_id cho hóa đơn cũ -->
        <record id="ir_cron_update_missing_dac_user_id" model="ir.cron">
            <field name="name">Cập nhật DAC User ID bị thiếu cho hóa đơn</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model._update_missing_dac_user_id()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>
        <record id="ir_cron_mcp_customer_care_auto_run" model="ir.cron">
            <field name="name">OpenClaw MCP Customer Care Auto-run</field>
            <field name="model_id" ref="model_dac_erp_mcp_auto_run_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_customer_care_auto_run()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>

    <!-- The cron was initially shipped under noupdate="1". Unlock its XML ID
         before updating so existing databases receive interval/code changes. -->
    <function model="ir.model.data" name="write">
        <value model="ir.model.data" search="[('module', '=', 'dac_erp'), ('name', '=', 'ir_cron_remind_missing_deposits')]"/>
        <value eval="{'noupdate': False}"/>
    </function>

    <!-- Keep this record updateable so the reminder interval can be tuned. -->
    <record id="ir_cron_remind_missing_deposits" model="ir.cron">
        <field name="name">Nhắc đơn hàng chưa có tiền cọc</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_remind_missing_deposits()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False"/>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
