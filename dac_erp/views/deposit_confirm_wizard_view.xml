<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_deposit_confirm_wizard_form" model="ir.ui.view">
            <field name="name">deposit.confirm.wizard.form</field>
            <field name="model">deposit.confirm.wizard</field>
            <field name="arch" type="xml">
                <form string="Ghi nhận thanh toán" class="dac-v6-dialog-form">
                    <field name="currency_id" invisible="1"/>
                    <field name="journal_type" invisible="1"/>

                    <div class="dac-v6-dialog-order">
                        <field name="order_name" nolabel="1" readonly="1"/> · Còn thanh toán
                        <strong><field name="amount_total_order" nolabel="1" readonly="1" widget="monetary"/></strong>
                    </div>

                    <group>
                        <field name="deposit_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="journal_id" string="Phương thức" options="{'no_create': True, 'no_open': True}"/>
                        <field name="payment_date" invisible="1"/>
                    </group>

                    <div class="dac-payment-proof-section" invisible="journal_type != 'bank'">
                        <div class="o_form_label">Hình ảnh chuyển khoản</div>
                        <div class="dac-payment-proof-toolbar">
                            <div>
                                <span>Dán ảnh bằng Ctrl V (Cmd V), sau đó có thể tải xuống hoặc xoá hình.</span>
                                <small class="dac-payment-proof-status d-block mt-1" role="status" aria-live="polite"/>
                            </div>
                            <div class="dac-payment-proof-actions">
                                <button name="dac_upload_payment_proof" type="button" class="btn btn-outline-primary dac-payment-proof-upload">
                                    <i class="fa fa-upload me-1"/>Tải ảnh lên
                                </button>
                                <button name="dac_paste_payment_proof" type="button" class="btn btn-outline-primary dac-payment-proof-paste">
                                    <i class="fa fa-clipboard me-1"/>Paste
                                </button>
                            </div>
                        </div>
                        <field name="payment_proof_filename" invisible="1"/>
                        <div class="dac-payment-proof-card d-none">
                            <field name="payment_proof_image"
                                   nolabel="1"
                                   widget="image"
                                   filename="payment_proof_filename"
                                   class="dac-payment-proof-image"
                                   options="{'accepted_file_extensions': 'image/*'}"/>
                            <strong class="dac-payment-proof-name">Hình ảnh chuyển khoản</strong>
                            <div class="dac-payment-proof-card-actions">
                                <button name="dac_download_payment_proof" type="button" class="btn btn-link dac-payment-proof-download">
                                    Tải ảnh
                                </button>
                                <button name="dac_remove_payment_proof" type="button" class="btn btn-link dac-payment-proof-remove">
                                    Xoá hình
                                </button>
                            </div>
                        </div>
                    </div>

                    <footer>
                        <button string="Hủy" special="cancel" class="btn-secondary"/>
                        <button string="Ghi nhận" type="object" name="action_confirm" class="btn-warning" invisible="not journal_id or not payment_date"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
