<odoo>
    <record id="ai_connection_list" model="ir.ui.view">
        <field name="name">dac.ai.connection.list</field><field name="model">dac.ai.connection</field>
        <field name="arch" type="xml"><list string="Kết nối AI dùng chung" decoration-muted="state == 'off'" decoration-warning="state == 'untested'">
            <field name="sequence" widget="handle"/>
            <field name="name"/>
            <field name="kind"/>
            <field name="model_summary"/>
            <field name="state" widget="badge" decoration-success="state == 'ready'" decoration-warning="state == 'untested'"/>
            <field name="ok_count"/>
            <field name="fail_count"/>
            <field name="last_error" optional="show"/>
            <field name="last_error_at" optional="hide"/>
            <field name="active" column_invisible="1"/>
        </list></field>
    </record>
    <record id="ai_connection_form" model="ir.ui.view">
        <field name="name">dac.ai.connection.form</field><field name="model">dac.ai.connection</field>
        <field name="arch" type="xml"><form string="Kết nối AI">
            <header>
                <button name="action_save" type="object" string="Lưu" icon="fa-save" class="btn-primary"/>
                <button name="action_load_models" type="object" string="Lấy danh sách model" icon="fa-refresh" class="btn-secondary"/>
                <button name="action_test" type="object" string="Kiểm tra các model đã chọn" icon="fa-flask" class="btn-secondary"
                        invisible="not model_line_ids"/>
                <field name="state" widget="statusbar" statusbar_visible="untested,ready"/>
            </header>
            <sheet>
                <widget name="web_ribbon" title="Đang tắt" bg_color="text-bg-secondary" invisible="active"/>
                <div class="oe_title"><label for="name"/><h1><field name="name" placeholder="vd 9router Duy An"/></h1></div>
                <div class="alert alert-info" role="status">
                    1. Nhập loại, địa chỉ, API key rồi bấm <b>Lưu</b>. 2. Bấm <b>Lấy danh sách model</b>. 3. Tích <b>Dùng</b> các model muốn dùng và
                    kéo để sắp thứ tự (model trên cùng dùng trước; lỗi hoặc quá tải thì dùng model kế tiếp). 4. Bấm <b>Kiểm tra các model đã chọn</b>:
                    chỉ model gọi tool được mới được dùng.
                </div>
                <group>
                    <group string="Kết nối">
                        <field name="kind" widget="radio"/>
                        <field name="base_url" invisible="kind != 'openai'" required="kind == 'openai'" placeholder="https://9router.duyan.vn/v1"/>
                        <field name="api_key" password="True" required="1"/>
                        <field name="active" widget="boolean_toggle"/>
                        <field name="note"/>
                    </group>
                    <group string="Tình trạng">
                        <field name="model_summary"/>
                        <field name="ok_count"/>
                        <field name="fail_count"/>
                        <field name="last_ok_at"/>
                        <field name="last_error" invisible="not last_error"/>
                        <field name="last_error_at" invisible="not last_error_at"/>
                    </group>
                </group>
                <separator string="Model (tích Dùng, kéo để sắp thứ tự dự phòng)"/>
                <field name="model_line_ids" nolabel="1">
                    <list editable="bottom" create="0" default_order="selected desc, sequence, id"
                          decoration-muted="not selected" decoration-success="status == 'ready'" decoration-warning="status == 'untested'">
                        <field name="sequence" widget="handle"/>
                        <field name="selected" widget="boolean_toggle"/>
                        <field name="name"/>
                        <field name="label" optional="hide"/>
                        <field name="status" widget="badge" decoration-success="status == 'ready'" decoration-warning="status == 'untested'"/>
                        <field name="ok_count" optional="show"/>
                        <field name="fail_count" optional="show"/>
                        <field name="last_error" optional="show"/>
                        <field name="verified" column_invisible="1"/>
                    </list>
                </field>
            </sheet>
        </form></field>
    </record>
    <record id="ai_connection_action" model="ir.actions.act_window">
        <field name="name">Kết nối AI dùng chung</field><field name="res_model">dac.ai.connection</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Chưa có kết nối AI nào</p>
            <p>Thêm kết nối (vd 9router tương thích OpenAI, Google Gemini) một lần để mọi module dùng chung: đọc tin khách Pancake,
            đánh giá mức gấp, tìm lịch hẹn của sale, hiểu câu nhân viên trả lời lead, trò chuyện với Trợ lý Zalo...
            Kéo để sắp thứ tự: kết nối đầu dùng trước, lỗi hoặc quá tải thì dùng kết nối kế tiếp.</p></field>
    </record>
    <record id="user_ai_model_list" model="ir.ui.view">
        <field name="name">res.users.list.dac.ai.model</field><field name="model">res.users</field><field name="priority">99</field>
        <field name="arch" type="xml"><list string="Model AI theo nhân viên" editable="bottom" create="0" delete="0">
            <field name="name" readonly="1"/>
            <field name="login" readonly="1"/>
            <field name="dac_ai_model_id" options="{'no_create': True, 'no_open': True}" placeholder="Theo thứ tự chung"/>
        </list></field>
    </record>
    <record id="user_ai_model_action" model="ir.actions.act_window">
        <field name="name">Model AI theo nhân viên</field><field name="res_model">res.users</field>
        <field name="view_mode">list</field><field name="view_id" ref="user_ai_model_list"/>
        <field name="domain">[('share', '=', False)]</field>
        <field name="help" type="html"><p>Chọn model AI riêng cho trợ lý của từng nhân viên (Trợ lý Zalo, Trợ lý DAC...). Để trống = dùng thứ tự chung
            ở Kết nối AI dùng chung. Model riêng lỗi hoặc quá tải thì tự quay về thứ tự chung.</p></field>
    </record>
    <menuitem id="menu_ai_root" name="AI dùng chung" parent="base.menu_administration" sequence="3" groups="base.group_system"/>
    <menuitem id="menu_ai_user_model" name="Model AI theo nhân viên" parent="menu_ai_root" action="user_ai_model_action" sequence="20"/>
    <menuitem id="menu_ai_connection" name="Kết nối AI" parent="menu_ai_root" action="ai_connection_action" sequence="10"/>
</odoo>
