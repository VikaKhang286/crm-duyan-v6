<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="dac_sale_dashboard.Dashboard">
    <div class="dac-viewport o_dac_manager_dashboard dac-sale-v6">
      <div t-if="state.loading" class="dac-sale-state"><i class="fa fa-spinner fa-spin"/> Đang tải dữ liệu...</div>
      <div t-elif="state.error" class="dac-sale-state dac-sale-error"><i class="fa fa-exclamation-circle"/> <t t-esc="state.error"/></div>
      <main t-else="" class="dac-sale-shell">
        <header class="dac-sale-header">
          <div>
            <div class="dac-sale-breadcrumb">DAC Bán hàng &amp; CRM / <span>Tổng quan</span></div>
            <h1>Dashboard Sale</h1>
            <p>Tổng quan kinh doanh, pipeline và các việc cần xử lý hôm nay.</p>
          </div>
          <div class="dac-sale-actions">
            <div class="dac-periods"><button t-att-class="periodClass('7d')" t-on-click="() => this.setPeriod('7d')">7 ngày</button><button t-att-class="periodClass('30d')" t-on-click="() => this.setPeriod('30d')">30 ngày</button><button t-att-class="periodClass('month')" t-on-click="() => this.setPeriod('month')">Tháng này</button><button t-att-class="periodClass('quarter')" t-on-click="() => this.setPeriod('quarter')">Quý</button></div>
            <button class="dac-btn" t-on-click="refresh"><i class="fa fa-refresh"/> Tải lại</button>
            <button class="dac-btn dac-btn-primary" t-on-click="createOrder"><i class="fa fa-plus"/> Tạo đơn</button>
          </div>
        </header>

        <section class="dac-sale-kpis">
          <article class="dac-kpi-card"><div class="dac-kpi-main"><div class="dac-kpi-heading"><span><t t-esc="state.period === 'month' ? 'Doanh thu tháng' : 'Doanh thu kỳ'"/></span><div class="dac-kpi-icon yellow"><i class="fa fa-bar-chart"/></div></div><strong><t t-esc="formatCompact(saleV6.kpi.revenue)"/></strong><small><b><t t-esc="formatSignedPercent(saleV6.kpi.revenue_change_percent)"/></b> so với <t t-esc="comparisonPeriodTitle"/></small></div><div class="dac-spark yellow"><svg class="spark" viewBox="0 0 100 40"><path d="M2 31 C14 27,18 31,28 23 S45 12,56 18 S70 27,82 14 S94 12,98 7" fill="none" stroke="#ffc20e" stroke-width="2"></path></svg></div></article>
          <article class="dac-kpi-card"><div class="dac-kpi-main"><div class="dac-kpi-heading"><span>Mục tiêu kỳ</span><div class="dac-kpi-icon green"><i class="fa fa-credit-card"/></div></div><strong><t t-esc="formatCompact(saleV6.kpi.target)"/></strong><small><b><t t-esc="saleV6.kpi.progress_percent || 0"/>%</b> đã hoàn thành</small><div class="dac-kpi-progress"><i t-att-style="'width:' + Math.min(saleV6.kpi.progress_percent || 0, 100) + '%'"/></div></div></article>
          <article class="dac-kpi-card"><div class="dac-kpi-main"><div class="dac-kpi-heading"><span>Đơn đã chốt</span><div class="dac-kpi-icon blue"><i class="fa fa-list-ul"/></div></div><strong><t t-esc="saleV6.kpi.closed || 0"/></strong><small><b><t t-esc="formatSignedInteger(saleV6.kpi.closed_delta)"/></b> đơn trong <t t-esc="periodUnitTitle"/> so với <t t-esc="comparisonPeriodTitle"/></small></div><div class="dac-spark blue"><svg class="spark" viewBox="0 0 100 40"><path d="M2 30 L15 29 26 25 38 28 49 20 61 22 72 15 84 17 98 9" fill="none" stroke="#2d7ff9" stroke-width="2"></path></svg></div></article>
          <article class="dac-kpi-card"><div class="dac-kpi-main"><div class="dac-kpi-heading"><span>Doanh thu dự kiến</span><div class="dac-kpi-icon yellow"><i class="fa fa-plus-square-o"/></div></div><strong><t t-esc="formatCompact(saleV6.kpi.expected)"/></strong><small><b><t t-esc="formatSignedCompact(saleV6.kpi.expected_delta)"/></b> so với <t t-esc="comparisonPeriodTitle"/> đang trong pipeline</small></div><div class="dac-spark orange"><svg class="spark" viewBox="0 0 100 40"><path d="M2 33 C20 29,22 17,38 21 S55 31,69 16 98 11" fill="none" stroke="#f59e0b" stroke-width="2"></path></svg></div></article>
        </section>

        <section class="dac-sale-grid dac-sale-grid-top">
          <article class="dac-sale-panel dac-revenue-panel">
            <div class="dac-panel-head dac-chart-head"><div><h2>Doanh thu &amp; mục tiêu</h2><p>Doanh thu theo ngày trong tháng <t t-esc="saleV6.period_label"/></p></div><div class="dac-chart-legend"><span><i class="actual"/>Doanh thu</span><span><i class="target"/>Mục tiêu lũy kế</span></div></div>
            <div class="dac-line-chart">
              <div class="dac-chart-grid"><i/><i/><i/><i/></div>
              <div class="dac-y-axis"><span t-foreach="revenueAxisLabels" t-as="label" t-key="label"><t t-esc="formatCompact(label)"/></span></div>
              <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-label="Biểu đồ doanh thu">
                <defs><linearGradient id="dacRevenueArea" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#ffbd12" stop-opacity=".2"/><stop offset="100%" stop-color="#ffbd12" stop-opacity="0"/></linearGradient></defs>
                <path class="revenue-area" style="fill: url(#dacRevenueArea); stroke: none" t-att-d="chartPath('revenue', true)"/>
                <path class="target-line" t-att-d="chartPath('target')"/>
                <path class="actual-line" t-att-d="chartPath('revenue')"/>
              </svg>
              <div class="dac-chart-axis"><span t-foreach="revenueDateLabels" t-as="dateLabel" t-key="dateLabel_index"><t t-esc="dateLabel"/></span></div>
            </div>
          </article>
          <article class="dac-sale-panel dac-source-panel">
            <div class="dac-panel-head dac-chart-head"><div><h2>Nguồn khách hàng</h2><p>Phân bổ lead theo kênh</p></div><button class="dac-link-btn" t-on-click="openOrders">Chi tiết</button></div>
            <div class="dac-source-content">
              <div class="dac-donut" t-att-style="'background:' + leadSourceStyle"><div><strong><t t-esc="leadSourceTotal"/></strong><span>lead mới</span></div></div>
              <div class="dac-source-list"><div t-foreach="saleV6.lead_sources" t-as="source" t-key="source.label"><span><i t-att-class="'source-' + source_index"/><t t-esc="source.label"/></span><strong><t t-esc="leadSourcePercent(source.count)"/>%</strong></div></div>
            </div>
          </article>
        </section>

        <section class="dac-sale-grid dac-sale-focus-grid">
          <article class="dac-sale-panel dac-pipeline-panel">
            <div class="dac-panel-head dac-focus-head"><div><h2>Sales Pipeline</h2><p>Tổng giá trị cơ hội: <strong><t t-esc="formatCompact(saleV6.pipeline_total)"/></strong></p></div><button class="dac-link-btn" t-on-click="openOrders">Xem toàn bộ</button></div>
            <div class="dac-pipeline">
              <article t-foreach="saleV6.pipeline" t-as="stage" t-key="stage.key" t-att-class="'dac-stage ' + stage.key">
                <span><t t-esc="stage.label"/></span>
                <strong><t t-esc="stage.count"/></strong>
                <small><t t-if="stage.amount"><t t-esc="formatCompact(stage.amount)"/></t><t t-else="">—</t></small>
                <b><t t-esc="stage.conversion"/>%</b>
              </article>
            </div>
          </article>

          <article class="dac-sale-panel dac-alert-panel">
            <div class="dac-panel-head dac-focus-head"><div><h2>Cần can thiệp hôm nay</h2><p>Ưu tiên theo SLA và deadline</p></div><span class="dac-alert-count"><i/> <t t-esc="(saleV6.alerts.overdue_orders || 0) + (saleV6.alerts.conversations || 0) + (saleV6.alerts.receivables || 0) + (saleV6.alerts.quotations || 0)"/> việc</span></div>
            <div class="dac-alert-list">
              <div class="dac-alert-row danger" t-on-click="openOrders"><b><t t-esc="saleV6.alerts.overdue_orders || 0"/></b><div><strong>Đơn quá deadline</strong><span><t t-esc="saleV6.alerts.overdue_production || 0"/> đơn sản xuất · <t t-esc="saleV6.alerts.overdue_design || 0"/> đơn thiết kế</span></div><i class="fa fa-angle-right"/></div>
              <div class="dac-alert-row warning" t-on-click="openConversationQueue"><b><t t-esc="saleV6.alerts.conversations || 0"/></b><div><strong>Hội thoại chưa phản hồi</strong><span>Quá SLA 30 phút</span></div><i class="fa fa-angle-right"/></div>
              <div class="dac-alert-row blue" t-on-click="openOrders"><b><t t-esc="saleV6.alerts.receivables || 0"/></b><div><strong>Đơn đã giao chưa thu đủ</strong><span>Còn phải thu <t t-esc="formatCompact(saleV6.alerts.receivables_amount)"/></span></div><i class="fa fa-angle-right"/></div>
              <div class="dac-alert-row warning" t-on-click="openOrders"><b><t t-esc="saleV6.alerts.quotations || 0"/></b><div><strong>Báo giá chờ xác nhận</strong><span>Giá trị <t t-esc="formatCompact(saleV6.alerts.quotation_amount)"/></span></div><i class="fa fa-angle-right"/></div>
            </div>
          </article>
        </section>

        <section class="dac-sale-grid dac-sale-grid-bottom dac-orders-only">
          <article class="dac-sale-panel dac-orders-panel">
            <div class="dac-panel-head dac-orders-head"><div><h2>Đơn hàng gần đây</h2><p>Click một đơn để mở Quick View</p></div><button class="dac-link-btn" t-on-click="openOrders">Xem tất cả đơn</button></div>
            <div class="dac-orders-table-wrap"><table class="dac-orders-table"><thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Sale</th><th>Giai đoạn</th><th>Deadline</th><th>Tổng tiền</th><th>Công nợ</th></tr></thead><tbody>
              <tr t-foreach="saleV6.recent_orders" t-as="order" t-key="order.id" t-on-click="() => this.openForm('sale.order', order.id)">
                <td class="dac-order-code"><strong><t t-esc="order.number"/></strong></td>
                <td><div class="dac-customer"><span><t t-esc="order.partner_initials"/></span><strong><t t-esc="order.partner"/></strong></div></td>
                <td><t t-esc="order.sale"/></td>
                <td><span t-att-class="'dac-order-status ' + order.state + (order.is_overdue ? ' overdue' : '')"><i/> <t t-esc="order.state_label"/></span></td>
                <td t-att-class="order.is_overdue ? 'dac-deadline overdue' : 'dac-deadline'"><t t-esc="order.deadline"/></td>
                <td><t t-esc="formatMoney(order.amount)"/></td>
                <td t-att-class="order.debt ? 'dac-debt has-debt' : 'dac-debt'"><t t-esc="formatMoney(order.debt)"/></td>
              </tr>
              <tr t-if="!saleV6.recent_orders.length"><td colspan="7" class="dac-empty">Chưa có đơn hàng</td></tr>
            </tbody></table></div>
          </article>
        </section>
      </main>
    </div>
  </t>
</templates>
