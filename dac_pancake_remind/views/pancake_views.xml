<odoo>
    <record id="pancake_page_list" model="ir.ui.view">
        <field name="name">dac.pancake.page.list</field><field name="model">dac.pancake.page</field>
        <field name="arch" type="xml"><list string="Page Pancake">
            <header>
                <button name="action_check_token" type="object" string="Kiểm tra token" class="btn-primary"/>
            </header>
            <field name="sequence" widget="handle"/>
            <field name="name"/>
            <field name="page_fm_id"/>
            <field name="has_token"/>
            <field name="token_status" widget="badge" decoration-success="token_status == 'valid'"
                   decoration-danger="token_status in ('invalid', 'error')"/>
            <field name="last_polled_at"/>
            <field name="history_progress" optional="show"/>
            <field name="last_error" optional="show"/>
            <field name="conversation_count" optional="show"/>
        </list></field>
    </record>
    <record id="pancake_page_form" model="ir.ui.view">
        <field name="name">dac.pancake.page.form</field><field name="model">dac.pancake.page</field>
        <field name="arch" type="xml"><form string="Page Pancake">
            <header>
                <button name="action_check_token" type="object" string="Kiểm tra token" class="btn-primary"/>
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button class="oe_stat_button" type="object" name="action_open_conversations" icon="fa-comments">
                        <field name="conversation_count" widget="statinfo" string="Hội thoại"/>
                    </button>
                </div>
                <widget name="web_ribbon" title="Đã lưu trữ" bg_color="text-bg-danger" invisible="active"/>
                <div class="oe_title"><label for="name"/><h1><field name="name" placeholder="VD: In Ấn - Quảng Cáo Duy An"/></h1></div>
                <group>
                    <group string="Kết nối">
                        <field name="page_fm_id" string="Page ID hoặc link Pancake" placeholder="VD: https://pancake.vn/pzl_849... hoặc 1234567890"/>
                        <field name="page_slug" invisible="not page_slug"/>
                        <field name="page_access_token" password="True" placeholder="Dán Page Access Token của page này"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <group string="Tình trạng">
                        <field name="token_status" widget="badge" decoration-success="token_status == 'valid'"
                               decoration-danger="token_status in ('invalid', 'error')"/>
                        <field name="token_message" invisible="not token_message"/>
                        <field name="token_checked_at" invisible="not token_checked_at"/>
                        <field name="last_polled_at"/>
                        <field name="last_error" invisible="not last_error"/>
                    </group>
                    <group string="Tin cũ">
                        <field name="history_enabled"/>
                        <field name="history_progress"/>
                        <button name="action_restart_history" type="object" string="Lấy lại toàn bộ tin cũ" class="btn-secondary"
                                confirm="Lấy lại từ đầu mọi hội thoại và tin cũ của page này (chạy nền, tin đã có không bị nhân đôi)?" colspan="2"/>
                    </group>
                </group>
                <div class="alert alert-info" role="status">
                    Lấy token: mở Pancake → chọn page → <strong>Cài đặt</strong> → <strong>Công cụ</strong> → <strong>Page Access Token</strong> → Tạo/Sao chép.
                    Ô Page ID nhận cả mã page lẫn link copy từ trình duyệt (<code>https://pancake.vn/...</code>); có token thì Odoo tự lấy
                    đúng mã page ghi trong token (page Zalo cá nhân có mã khác số điện thoại trên link). Dán vào, bấm <strong>Lưu</strong> rồi <strong>Kiểm tra token</strong>.
                    Luồng này chỉ đọc tin từ Pancake, không gửi tin.
                </div>
            </sheet>
        </form></field>
    </record>
    <record id="pancake_page_action" model="ir.actions.act_window">
        <field name="name">Page Pancake</field><field name="res_model">dac.pancake.page</field><field name="view_mode">list,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Chưa có page nào</p>
            <p>Bấm <strong>Mới</strong>, nhập tên page, Page ID và Page Access Token (Pancake → Cài đặt page → Công cụ), Lưu rồi Kiểm tra token.</p></field>
    </record>

    <record id="pancake_conversation_list" model="ir.ui.view">
        <field name="name">dac.pancake.conversation.list</field><field name="model">dac.pancake.conversation</field>
        <field name="arch" type="xml"><list string="Hội thoại Pancake" create="0" edit="0">
            <field name="updated_at_fm"/><field name="customer_name"/><field name="page_id"/><field name="platform" optional="show"/>
            <field name="snippet" optional="show"/><field name="partner_id" optional="hide"/><field name="inserted_at_fm" optional="hide"/>
            <field name="is_internal" optional="show"/><field name="history_state" optional="hide"/>
            <field name="external_url" widget="url"/>
        </list></field>
    </record>
    <record id="pancake_conversation_form" model="ir.ui.view">
        <field name="name">dac.pancake.conversation.form</field><field name="model">dac.pancake.conversation</field>
        <field name="arch" type="xml"><form string="Hội thoại Pancake" create="0" edit="0">
            <header>
                <button name="action_open_pancake" type="object" string="Mở trên Pancake" class="btn-primary"/>
                <button name="action_mark_internal" type="object" string="Đánh dấu nội bộ" invisible="is_internal"
                        help="Không tính vào thống kê khách liên hệ và không nhắc trả lời"/>
                <button name="action_unmark_internal" type="object" string="Bỏ đánh dấu nội bộ" invisible="not is_internal"/>
            </header>
            <sheet>
                <widget name="web_ribbon" title="Nội bộ" bg_color="text-bg-secondary" invisible="not is_internal"/>
                <div class="oe_title"><h1><field name="customer_name"/></h1></div>
                <group>
                    <group><field name="page_id"/><field name="platform"/><field name="partner_id"/><field name="external_url" widget="url"/></group>
                    <group><field name="inserted_at_fm"/><field name="updated_at_fm"/><field name="messages_updated_at"/>
                        <field name="history_state"/><field name="message_count_fm"/><field name="is_internal" invisible="1"/></group>
                </group>
                <field name="message_ids"><list><field name="inserted_at"/><field name="sender_name"/><field name="type_content"/><field name="content_html"/>
                    <field name="attachment_urls" optional="show"/></list></field>
            </sheet>
        </form></field>
    </record>
    <record id="pancake_conversation_search" model="ir.ui.view">
        <field name="name">dac.pancake.conversation.search</field><field name="model">dac.pancake.conversation</field>
        <field name="arch" type="xml"><search>
            <field name="customer_name"/><field name="page_id"/>
            <filter name="internal" string="Nội bộ" domain="[('is_internal', '=', True)]"/>
            <filter name="not_internal" string="Không phải nội bộ" domain="[('is_internal', '=', False)]"/>
            <separator/>
            <filter name="history_pending" string="Chưa lấy đủ tin cũ" domain="[('history_state', '!=', 'done')]"/>
            <group expand="0" string="Nhóm theo"><filter name="g_page" string="Page" context="{'group_by': 'page_id'}"/></group>
        </search></field>
    </record>
    <record id="pancake_conversation_action" model="ir.actions.act_window">
        <field name="name">Hội thoại Pancake</field><field name="res_model">dac.pancake.conversation</field><field name="view_mode">list,form</field>
    </record>
</odoo>
